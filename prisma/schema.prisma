// Urvar Natural CRM — Prisma 7 schema
// Generator uses the new `prisma-client` provider (Prisma 7) with an explicit output.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  DISTRIBUTOR_MANAGER
  ACCOUNTS_TEAM
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  META_ADS
  GOOGLE_ADS
  TRADE_SHOW
  REFERRAL
  DISTRIBUTOR
  DIRECT_CALL
  WHATSAPP
  ORGANIC_SEARCH
  GOVERNMENT_TENDER
  OTHER
}

enum CustomerType {
  B2C_FARMER
  B2B_RETAILER
  B2B_DEALER
  B2B_DISTRIBUTOR
  AGRI_INPUT_SHOP
  FPO_COOPERATIVE
  NGO
  GOVERNMENT
  CORPORATE_FARM
  PLANTATION
}

enum DealerTier {
  GOLD
  SILVER
  BRONZE
}

enum PipelineStage {
  NEW_LEAD
  FIRST_CONTACT
  REQUIREMENT_GATHERING
  PRODUCT_DISCUSSION
  SAMPLE_SENT
  QUOTATION_SENT
  NEGOTIATION
  ORDER_RECEIVED
  WON
  LOST
}

enum ActivityType {
  NOTE
  STATUS_CHANGE
  STAGE_CHANGE
  CALL_LOGGED
  FOLLOWUP_LOGGED
  FOLLOWUP_COMPLETED
  TASK_CREATED
  QUOTATION_CREATED
  QUOTATION_SENT
  LEAD_ASSIGNED
  LEAD_CONVERTED
  FILE_ATTACHED
  EMAIL_SENT
  WHATSAPP_SENT
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallOutcome {
  CONNECTED
  NOT_REACHABLE
  BUSY
  INTERESTED
  FOLLOW_UP_REQUIRED
  QUOTATION_REQUESTED
  CONVERTED
  WRONG_NUMBER
  TRANSFERRED_TO_HUMAN
}

enum CallProvider {
  MANUAL
  TWILIO
  PLIVO
}

// AI Voice Agent: whether a call is fully human, human-driven with a passive
// AI transcript/suggestion overlay, or fully AI-driven (no human on the line).
enum CallMode {
  HUMAN
  AI_ASSISTED
  AI_AUTONOMOUS
}

enum CallSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  ESCALATED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ProductCategory {
  VERMICOMPOST
  PROM
  HUMIC_ACID
  ORGANIC_FERTILIZER
  MICRONUTRIENT
  SOIL_CONDITIONER
  BIO_FERTILIZER
  CROP_NUTRITION
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum NotificationType {
  FOLLOWUP_DUE
  LEAD_ASSIGNED
  QUOTATION_RESPONSE
  TASK_ASSIGNED
  TASK_DUE
  STAGE_CHANGE
  GENERAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

/// Why an outbound message was sent. Separate from NotificationType, which
/// describes an in-app notification's subject: a MessageLog row is a record of
/// something that left the building over EMAIL or WHATSAPP.
enum MessagePurpose {
  QUOTATION_SENT
  FOLLOWUP_REMINDER
  GENERAL
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum FileCategory {
  QUOTATION_PDF
  ATTACHMENT
  FIELD_VISIT_PHOTO
}

// ============================================================
// AUTH (Better Auth core models + app fields on User)
// ============================================================

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // App-specific fields
  role            Role      @default(SALES_EXECUTIVE)
  phone           String?
  territoryStates String[]  @default([])
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?

  // Plivo Voice: persistent SIP Endpoint credentials for in-browser calling,
  // created lazily on first call and reused (unlike Twilio's ephemeral tokens).
  plivoEndpointId        String?
  plivoUsername          String? @unique
  plivoPasswordEncrypted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // App relations
  ownedLeads              Lead[]                 @relation("LeadOwner")
  ownedCustomers          Customer[]             @relation("CustomerOwner")
  calls                   Call[]
  transferredCalls        Call[]                 @relation("CallTransferredTo")
  followUps               FollowUp[]
  assignedTasks           Task[]                 @relation("TaskAssignee")
  createdTasks            Task[]                 @relation("TaskCreator")
  createdQuotations       Quotation[]            @relation("QuotationCreator")
  createdOrders           Order[]                @relation("OrderCreator")
  createdSuppliers        Supplier[]             @relation("SupplierCreator")
  createdPurchaseInvoices PurchaseInvoice[]      @relation("PurchaseInvoiceCreator")
  leadActivities          LeadActivity[]
  pipelineMoves           PipelineStageHistory[]
  uploadedFiles           File[]
  notifications           Notification[]
  sentMessages            MessageLog[]
  fieldVisits             FieldVisit[]
  auditLogs               AuditLog[]
  postedEntries           JournalEntry[]         @relation("JournalPoster")
  closedPeriods           FinancialPeriod[]      @relation("PeriodCloser")
  salesInvoicesCreated    SalesInvoice[]         @relation("SalesInvoiceCreator")
  receiptsCreated         Receipt[]              @relation("ReceiptCreator")
  creditNotesCreated      CreditNote[]           @relation("CreditNoteCreator")
  supplierPaymentsCreated SupplierPayment[]      @relation("SupplierPaymentCreator")
  expensesCreated         Expense[]              @relation("ExpenseCreator")
  expensesApproved        Expense[]              @relation("ExpenseApprover")
  stockValuationsCreated  StockValuation[]       @relation("StockValuationCreator")
  // Phase 9 — Cash, Bank, Loans & Fixed Assets.
  cashBankTxnsCreated        CashBankTransaction[] @relation("CashBankTxnCreator")
  loansCreated               Loan[]                @relation("LoanCreator")
  loanRepaymentsCreated      LoanRepayment[]       @relation("LoanRepaymentCreator")
  fixedAssetsCreated         FixedAsset[]          @relation("FixedAssetCreator")
  depreciationEntriesCreated DepreciationEntry[]   @relation("DepreciationEntryCreator")

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ============================================================
// CRM CORE
// ============================================================

model Lead {
  id            String       @id @default(cuid())
  leadNumber    String       @unique
  name          String
  companyName   String?
  contactPerson String?
  phone         String
  whatsapp      String?
  altPhone      String?
  email         String?
  state         String
  district      String
  pincode       String?
  address       String?
  source        LeadSource   @default(DIRECT_CALL)
  status        LeadStatus   @default(NEW)
  customerType  CustomerType @default(B2C_FARMER)

  interestedProducts   String?
  expectedQuantity     String?
  expectedMonthlyValue Decimal? @db.Decimal(12, 2)
  estimatedValue       Decimal? @db.Decimal(12, 2)
  cropInterest         String?
  isGovernmentTender   Boolean  @default(false)
  remarks              String?
  lostReason           String?

  // AI Voice Agent: opt-out enforced by the outbound campaign scheduler (Phase 3)
  doNotCall       Boolean @default(false)
  doNotCallReason String?

  // Phase-2 hooks (free, nullable)
  whatsappOptIn     Boolean?
  leadScore         Int?
  // BCP-47 code (e.g. "bn-IN") of the language AI calls to this lead should
  // open in, overriding the Lead.state guess in tts-language.ts (a proxy,
  // wrong for anyone who has moved states). Null means "use the state".
  // Set by a rep in the lead form — deliberately NOT written by the voice
  // agent: auto-detecting it from one utterance per call stored Telugu for a
  // West Bengal farmer off the mis-heard "Ice cream", and nothing in the UI
  // showed it. Mirrors the (still unused) Customer.preferredLanguage.
  preferredLanguage String?

  assignedToId String?
  assignedTo   User?   @relation("LeadOwner", fields: [assignedToId], references: [id])

  convertedCustomer Customer? @relation("LeadConversion")
  convertedAt       DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipeline      Pipeline?
  activities    LeadActivity[]
  calls         Call[]
  followUps     FollowUp[]
  tasks         Task[]
  quotations    Quotation[]
  orders        Order[]
  notifications Notification[]
  messageLogs   MessageLog[]
  fieldVisits   FieldVisit[]
  files         File[]

  @@index([status])
  @@index([state])
  @@index([assignedToId])
  @@index([createdAt])
}

model Pipeline {
  id                String        @id @default(cuid())
  leadId            String        @unique
  lead              Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage             PipelineStage @default(NEW_LEAD)
  enteredStageAt    DateTime      @default(now())
  expectedCloseDate DateTime?
  probability       Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  stageHistory PipelineStageHistory[]

  @@index([stage])
}

model PipelineStageHistory {
  id         String         @id @default(cuid())
  pipelineId String
  pipeline   Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  fromStage  PipelineStage?
  toStage    PipelineStage
  movedById  String
  movedBy    User           @relation(fields: [movedById], references: [id])
  movedAt    DateTime       @default(now())

  @@index([pipelineId])
}

model LeadActivity {
  id          String       @id @default(cuid())
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        ActivityType
  description String
  metadata    Json?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([leadId, createdAt])
}

model Call {
  id              String        @id @default(cuid())
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Nullable: an AI_AUTONOMOUS call (Phase 2+) has no human on the line.
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  direction       CallDirection @default(OUTBOUND)
  outcome         CallOutcome?
  durationSeconds Int?
  notes           String?
  calledAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())

  // Provider Voice (in-browser calling) fields — null/MANUAL for Sprint 2 manual logs
  provider        CallProvider @default(MANUAL)
  providerCallSid String?      @unique
  providerStatus  String?
  recordingUrl    String?
  recordingSid    String?
  fromNumber      String?
  toNumber        String?

  // AI Voice Agent (Phase 0+): AI transcript/outcome metadata, supplementary
  // to the human-picked outcome/notes above — never overwrites them.
  callMode       CallMode       @default(HUMAN)
  transcript     Json?
  /// Structured extraction of the call: crop, acreage, quantity, objections,
  /// purchase intent, next action. A free-text summary reads well but cannot
  /// be queried or fed back into the next call's prompt; this can.
  aiStructured   Json?
  /// Per-call latency and audio-transport telemetry — see
  /// voice-agent/pipeline/turn-metrics.ts. Stored per call rather than per
  /// turn: the write piggybacks on the update finalizeSession already makes,
  /// and a call's turns are always read together anyway.
  aiMetrics      Json?
  aiSummary      String?
  aiSentiment    CallSentiment?
  aiIntentTags   String[]       @default([])
  aiAgentVersion String?

  // Live-transfer handoff target (Phase 2)
  transferredToUserId String?
  transferredToUser   User?   @relation("CallTransferredTo", fields: [transferredToUserId], references: [id])

  // Flag-for-callback handoff (Phase 2): the FollowUp task the AI created
  followUpId String?   @unique
  followUp   FollowUp? @relation(fields: [followUpId], references: [id])

  @@index([leadId])
  @@index([customerId])
  @@index([userId, calledAt])
  @@index([callMode])
}

model FollowUp {
  id             String         @id @default(cuid())
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedToId   String
  assignedTo     User           @relation(fields: [assignedToId], references: [id])
  dueAt          DateTime
  priority       TaskPriority   @default(MEDIUM)
  status         FollowUpStatus @default(PENDING)
  notes          String?
  completedAt    DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // AI Voice Agent (Phase 2): the call that flagged this callback, if any
  call Call?

  @@index([assignedToId, dueAt])
  @@index([status])
}

model Task {
  id                String       @id @default(cuid())
  title             String
  description       String?
  assignedToId      String
  assignedTo        User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedById      String
  assignedBy        User         @relation("TaskCreator", fields: [assignedById], references: [id])
  relatedLeadId     String?
  relatedLead       Lead?        @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)
  relatedCustomerId String?
  relatedCustomer   Customer?    @relation(fields: [relatedCustomerId], references: [id], onDelete: SetNull)
  dueAt             DateTime?
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(OPEN)
  completedAt       DateTime?
  /// Set once the due-reminder cron has emailed/notified the assignee, so a
  /// task that stays open past its due date is not re-reminded every tick.
  /// Mirrors FollowUp.reminderSentAt.
  reminderSentAt    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([assignedToId, status])
  /// The due-reminder cron scans on dueAt + reminderSentAt, not assignee.
  @@index([status, dueAt])
}

model Customer {
  id             String       @id @default(cuid())
  customerNumber String       @unique
  name           String
  companyName    String?
  contactPerson  String?
  customerType   CustomerType @default(B2C_FARMER)
  phone          String
  whatsapp       String?
  altPhone       String?
  email          String?
  state          String
  district       String
  pincode        String?
  address        String?
  latitude       Float?
  longitude      Float?
  gstNumber      String?
  panNumber      String?

  creditLimit       Decimal? @db.Decimal(12, 2)
  outstandingAmount Decimal  @default(0) @db.Decimal(12, 2)
  annualPurchase    Decimal? @db.Decimal(14, 2)

  // Distributor / Dealer-specific (nullable)
  dealerTier        DealerTier?
  territoryAssigned String?
  annualTargetValue Decimal?    @db.Decimal(14, 2)

  // Phase-2 hooks
  preferredLanguage String?

  assignedToId String?
  assignedTo   User?   @relation("CustomerOwner", fields: [assignedToId], references: [id])

  sourceLeadId String? @unique
  sourceLead   Lead?   @relation("LeadConversion", fields: [sourceLeadId], references: [id])

  isActive Boolean @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls         Call[]
  followUps     FollowUp[]
  tasks         Task[]
  quotations    Quotation[]
  orders        Order[]
  notifications Notification[]
  messageLogs   MessageLog[]
  fieldVisits   FieldVisit[]
  files         File[]
  salesInvoices SalesInvoice[]
  receipts      Receipt[]
  creditNotes   CreditNote[]

  @@index([customerType])
  @@index([state])
  @@index([assignedToId])
}

model Product {
  id               String          @id @default(cuid())
  sku              String          @unique
  name             String
  category         ProductCategory
  hsnCode          String?
  description      String?
  unit             String
  packSize         String?
  mrp              Decimal         @db.Decimal(12, 2)
  dealerPrice      Decimal?        @db.Decimal(12, 2)
  distributorPrice Decimal?        @db.Decimal(12, 2)
  gstPercent       Decimal         @default(5) @db.Decimal(5, 2)
  isActive         Boolean         @default(true)

  // Agronomy facts the AI voice agent needs to hold a real conversation with
  // a farmer. Before these existed it could quote a pack size and a price and
  // nothing else, so "কত দিতে হবে বিঘা প্রতি?" — the first question anyone
  // actually asks — had no answer.
  //
  // All nullable and all authored by Urvar's own agronomist. An unfilled
  // field makes the agent say it will confirm and call back, which is the
  // correct behaviour: a wrong dosage told to a farmer is not a UX problem,
  // it is a ruined crop, so nothing here may ever be inferred by a model.
  targetCrops       String?
  problemSolved     String?
  dosage            String?
  applicationMethod String?
  nutrientContent   String?
  benefits          String?
  /// Rep-facing notes for common pushback on this specific product.
  objectionNotes    String?
  availability      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotationItems     QuotationItem[]
  purchaseItems      PurchaseInvoiceItem[]
  orderItems         OrderItem[]
  salesInvoiceItems  SalesInvoiceItem[]
  stockValuationLines StockValuationLine[]
  creditNoteItems   CreditNoteItem[]

  @@index([category])
}

model Quotation {
  id                 String          @id @default(cuid())
  quotationNumber    String          @unique
  leadId             String?
  lead               Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdById        String
  createdBy          User            @relation("QuotationCreator", fields: [createdById], references: [id])
  status             QuotationStatus @default(DRAFT)
  validUntil         DateTime?
  subtotal           Decimal         @default(0) @db.Decimal(14, 2)
  discountPercent    Decimal         @default(0) @db.Decimal(5, 2)
  discountAmount     Decimal         @default(0) @db.Decimal(14, 2)
  freightAmount      Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(14, 2)
  totalAmount        Decimal         @default(0) @db.Decimal(14, 2)
  termsAndConditions String?
  notes              String?
  sentAt             DateTime?
  respondedAt        DateTime?
  /// Phase 6 of the sales-funnel automation roadmap: an unguessable bearer
  /// token minted when a quotation moves to SENT, letting the customer
  /// accept it via an emailed link (src/app/api/quotations/accept/[token])
  /// with no CRM session. Nullable because DRAFT quotations, and any
  /// quotation sent before this shipped, have none.
  acceptToken        String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items         QuotationItem[]
  order         Order?
  files         File[]
  messageLogs   MessageLog[]
  salesInvoices SalesInvoice[]

  @@index([status])
  @@index([customerId])
  @@index([createdById])
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  description     String?
  quantity        Decimal   @db.Decimal(12, 2)
  unitPrice       Decimal   @db.Decimal(12, 2)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal   @db.Decimal(14, 2)

  @@index([quotationId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  quotationId   String?       @unique
  quotation     Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  leadId        String?
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  totalAmount   Decimal       @db.Decimal(14, 2)
  status        OrderStatus   @default(CONFIRMED)
  paymentStatus PaymentStatus @default(PENDING)
  // Denormalized from customer for fast territory-revenue dashboard queries
  state         String
  district      String
  orderedAt     DateTime      @default(now())
  deliveredAt   DateTime?
  createdById   String
  createdBy     User          @relation("OrderCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         OrderItem[]
  salesInvoices SalesInvoice[]

  @@index([customerId])
  @@index([state])
  @@index([orderedAt])
}

model Notification {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  channel           NotificationChannel @default(IN_APP)
  title             String
  body              String?
  relatedLeadId     String?
  relatedLead       Lead?               @relation(fields: [relatedLeadId], references: [id], onDelete: Cascade)
  relatedCustomerId String?
  relatedCustomer   Customer?           @relation(fields: [relatedCustomerId], references: [id], onDelete: Cascade)
  isRead            Boolean             @default(false)
  createdAt         DateTime            @default(now())

  @@index([userId, isRead])
}

/// A record of an outbound message that actually left the building — email or
/// WhatsApp — to a lead or customer. Notification (above) is the in-app
/// inbox for our own staff; this is the ledger of what we sent to the outside
/// world, including failures, so "did the customer ever get the quotation?"
/// has an answer that does not depend on the provider's own dashboard.
///
/// Attaches to either a Lead or a Customer, never both, exactly like Call.
model MessageLog {
  id          String     @id @default(cuid())
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The quotation this message was about, when it was about one.
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  /// Null for a message the due-reminder cron sent with no human behind it.
  sentById    String?
  sentBy      User?      @relation(fields: [sentById], references: [id])

  channel   NotificationChannel
  purpose   MessagePurpose
  /// The address or number actually dialled/mailed, captured as sent rather
  /// than re-read off the lead/customer later, which may have since changed.
  recipient String
  /// Email subject, or the WhatsApp template name for a template message.
  subject   String?

  status            MessageDeliveryStatus @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime              @default(now())
  deliveredAt       DateTime?

  @@index([leadId])
  @@index([customerId])
  @@index([quotationId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model File {
  id                       String           @id @default(cuid())
  fileName                 String
  filePath                 String
  mimeType                 String
  sizeBytes                Int
  category                 FileCategory     @default(ATTACHMENT)
  relatedLeadId            String?
  relatedLead              Lead?            @relation(fields: [relatedLeadId], references: [id], onDelete: Cascade)
  relatedCustomerId        String?
  relatedCustomer          Customer?        @relation(fields: [relatedCustomerId], references: [id], onDelete: Cascade)
  relatedQuotationId       String?
  relatedQuotation         Quotation?       @relation(fields: [relatedQuotationId], references: [id], onDelete: Cascade)
  // The scanned supplier invoice this record was created from.
  relatedPurchaseInvoiceId String?
  relatedPurchaseInvoice   PurchaseInvoice? @relation(fields: [relatedPurchaseInvoiceId], references: [id], onDelete: Cascade)
  // A photo taken at a field visit (shop front, crop, site).
  relatedFieldVisitId      String?
  relatedFieldVisit        FieldVisit?      @relation(fields: [relatedFieldVisitId], references: [id], onDelete: Cascade)
  // A receipt/bill photo attached to an expense entry.
  relatedExpenseId         String?
  relatedExpense           Expense?         @relation(fields: [relatedExpenseId], references: [id], onDelete: Cascade)
  uploadedById             String
  uploadedBy               User             @relation(fields: [uploadedById], references: [id])
  createdAt                DateTime         @default(now())

  @@index([relatedQuotationId])
  @@index([relatedLeadId])
  @@index([relatedCustomerId])
  @@index([relatedPurchaseInvoiceId])
  @@index([relatedFieldVisitId])
  @@index([relatedExpenseId])
}

/// A rep's visit to a lead or customer in the field, captured on their phone.
///
/// The coordinates live here rather than on the lead/customer because they
/// answer a different question: Customer.latitude/longitude is where the shop
/// *is*, while this is where the rep *was*, at a time, on one occasion. A Lead
/// has no location columns at all, so for leads this is the only spatial
/// record there is.
///
/// checkOut* stay null while a visit is open — at most one open visit per rep
/// at a time, enforced in the check-in action rather than by constraint.
model FieldVisit {
  id         String    @id @default(cuid())
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id])

  checkInAt       DateTime @default(now())
  checkInLat      Float
  checkInLng      Float
  /// Metres of uncertainty the browser reported, kept so a wildly imprecise
  /// fix (a desktop on wifi) is distinguishable from a real GPS one.
  checkInAccuracy Float?

  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files File[]

  @@index([leadId])
  @@index([customerId])
  @@index([userId, checkInAt])
}

/// Procurement — the inbound side of the business. Everything else in this
/// schema is outbound (Quotation -> Order); these three models are the only
/// record of what Urvar buys, and exist so a scanned supplier invoice has
/// somewhere to land. Visible to SUPER_ADMIN and ACCOUNTS_TEAM only: supplier
/// prices reveal margin, so the `purchases` module grants sales roles nothing.
model Supplier {
  id            String            @id @default(cuid())
  supplierCode  String            @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  gstNumber     String?
  address       String?
  /// Nullable because suppliers are created as a side effect of saving a
  /// scanned invoice and OCR doesn't extract it. Required before a purchase
  /// invoice for this supplier can be POSTED — postPurchaseInvoice() needs it
  /// to determine CGST+SGST vs IGST, and refuses to guess. See
  /// src/app/(dashboard)/purchases/[invoiceId]/set-supplier-state.tsx for the
  /// one place this gets filled in.
  state         String?
  district      String?
  isActive      Boolean           @default(true)
  notes         String?
  invoices      PurchaseInvoice[]
  payments      SupplierPayment[]
  createdById   String
  createdBy     User              @relation("SupplierCreator", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([name])
}

enum PurchaseInvoiceStatus {
  /// Captured (often by OCR) but not yet posted — deliberately a real state,
  /// unlike SalesInvoice which posts at creation. A misread total from a
  /// photographed invoice should not reach the ledger unreviewed; a person
  /// checks it on the detail page and posts it explicitly.
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model PurchaseInvoice {
  id            String   @id @default(cuid())
  /// The supplier's own invoice number, not ours — so it is unique per
  /// supplier rather than globally. Two suppliers may both issue "INV-001".
  invoiceNumber String
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  invoiceDate   DateTime
  subtotal      Decimal  @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal  @db.Decimal(14, 2)

  /// Set at posting time from Supplier.state vs Company.state — never
  /// guessed, and posting refuses to proceed while this is null. The header
  /// only captures one blended taxAmount (OCR extraction asks for a single
  /// tax figure, not a rate or HSN per line, unlike the sales side's
  /// TaxRate-driven split), so ITC is split proportionally from that one
  /// figure rather than computed line-by-line. A true per-line HSN/rate
  /// capture on the purchase side is a real gap, not a design choice — it
  /// would need the OCR schema in purchases/actions.ts extended first.
  isInterState Boolean?
  cgstAmount   Decimal  @default(0) @db.Decimal(14, 2)
  sgstAmount   Decimal  @default(0) @db.Decimal(14, 2)
  igstAmount   Decimal  @default(0) @db.Decimal(14, 2)

  status PurchaseInvoiceStatus @default(DRAFT)

  /// Mirrors SalesInvoice.isOpeningItem — a balance migrated from Vyapar as
  /// of the cut-over date, not a fresh purchase. Posts to AP and Opening
  /// Balance Equity, never to Purchases, and is excluded from GST input
  /// registers the same way an opening sales invoice is excluded from output
  /// registers: that ITC was already claimed under the old system.
  isOpeningItem Boolean @default(false)

  postedEntryId String?   @unique
  postedAt      DateTime?
  cancelledAt   DateTime?

  notes       String?
  items       PurchaseInvoiceItem[]
  files       File[]
  allocations SupplierPaymentAllocation[]
  /// Set when this invoice's spend was capitalised into the fixed asset
  /// register (Phase 9) rather than expensed — see FixedAsset's own comment
  /// for why that is a reclassification off PURCHASES, never a second AP line.
  capitalizedAsset FixedAsset?
  createdById String
  createdBy   User                        @relation("PurchaseInvoiceCreator", fields: [createdById], references: [id])
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  /// Re-entering the same invoice for the same supplier is a mistake, and
  /// the likeliest one when invoices are captured by photographing them.
  @@unique([supplierId, invoiceNumber])
  @@index([invoiceDate])
  @@index([status])
}

model PurchaseInvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Optional, unlike QuotationItem.productId: a supplier invoice lists what
  /// THEY sell, which often will not match a row in our Product catalogue.
  /// Forcing a match would make such an invoice impossible to record, so the
  /// raw `description` is always kept and the link is made when it can be.
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id])
  description String
  quantity    Decimal         @db.Decimal(12, 2)
  unitPrice   Decimal         @db.Decimal(12, 2)
  lineTotal   Decimal         @db.Decimal(14, 2)

  @@index([invoiceId])
}

// ============================================================
// ACCOUNTING — double-entry foundation (Phase 1)
//
// Design rule for everything below: a financial document is a business
// record, and posting is a separate, centralized step that emits a balanced
// JournalEntry. Documents never write GL rows themselves and never store a
// balance — every balance is derived from posted JournalLines. See
// src/lib/accounting/posting.ts, the only module permitted to write here.
//
// Deliberately NOT multi-tenant at the ledger level. Company scopes the
// things that genuinely belong to a legal entity (periods, numbering), but
// LedgerAccount and JournalEntry are not company-scoped: Urvar is one Pvt
// Ltd, and threading a tenant key through every posting call to support a
// second entity that does not exist would cost more than it saves.
// ============================================================

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Which side increases this account. Stored rather than derived from `type`
/// so a contra account — Sales Returns is an INCOME account that normally
/// carries a debit — is representable without a special case.
enum NormalBalance {
  DEBIT
  CREDIT
}

enum FinancialPeriodStatus {
  /// Accepts postings.
  OPEN
  /// No new postings. Reopenable by SUPER_ADMIN.
  CLOSED
  /// Permanently sealed — returns filed against it. Never reopenable.
  LOCKED
}

enum JournalSourceType {
  MANUAL
  SALES_INVOICE
  RECEIPT
  CREDIT_NOTE
  DEBIT_NOTE
  SUPPLIER_BILL
  SUPPLIER_PAYMENT
  EXPENSE
  STOCK_MOVEMENT
  OPENING_BALANCE
  REVERSAL
  /// Phase 9 — Cash, Bank, Loans & Fixed Assets.
  CASH_BANK_TRANSFER
  LOAN
  LOAN_REPAYMENT
  FIXED_ASSET
  DEPRECIATION
  ASSET_DISPOSAL
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

/// Subledger attribution for an AR/AP line. Not an FK because the party may
/// live in either the Customer or the Supplier table.
enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum TaxTreatment {
  TAXABLE
  NIL_RATED
  EXEMPT
  /// Exports and SEZ supplies.
  ZERO_RATED
  NON_GST
}

/// The selling legal entity. One row in practice, but a table rather than
/// constants so the GSTIN, address and bank details printed on a tax invoice
/// come from data an admin can correct — not from a string literal baked
/// into a PDF template, which is where the current quotation PDF keeps them.
model Company {
  id        String  @id @default(cuid())
  legalName String
  tradeName String?
  gstin     String?
  pan       String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  /// Origin state for place-of-supply comparison. An invoice is intra-state
  /// (CGST+SGST) when this equals the customer's place of supply, and
  /// inter-state (IGST) otherwise.
  state        String
  /// GST numeric state code, e.g. "19" for West Bengal.
  stateCode    String?
  pincode      String?

  phone String?
  email String?

  bankName      String?
  bankAccountNo String?
  bankIfsc      String?
  bankBranch    String?

  /// Financial year start month, 1-12. India is 4 (April). Configurable
  /// rather than assumed, but defaulted so nothing has to set it.
  fyStartMonth Int     @default(4)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialPeriods FinancialPeriod[]
  documentSeries   DocumentSeries[]
  salesInvoices    SalesInvoice[]
  receipts         Receipt[]
  creditNotes      CreditNote[]
  purchaseInvoices PurchaseInvoice[]
  supplierPayments SupplierPayment[]
  expenses         Expense[]
  stockValuations  StockValuation[]
}

/// A node in the chart of accounts.
model LedgerAccount {
  id String @id @default(cuid())

  /// Stable, human-meaningful identifier used in reports and referenced by
  /// AccountMapping. Immutable once postings exist against the account.
  code String @unique
  name String

  type          LedgerAccountType
  normalBalance NormalBalance

  parentId String?
  parent   LedgerAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children LedgerAccount[] @relation("AccountTree")

  /// Only leaf accounts may carry postings. A parent exists to group and
  /// subtotal its children; posting directly to it would double-count in
  /// every rolled-up report.
  isPostable Boolean @default(true)

  /// Created by the chart-of-accounts seed and resolved by AccountMapping.
  /// May be renamed, never deleted or deactivated — the posting service
  /// depends on it existing.
  isSystem Boolean @default(false)

  isActive    Boolean @default(true)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines                  JournalLine[]
  mappings               AccountMapping[]
  receiptDeposits        Receipt[]         @relation("ReceiptDeposit")
  supplierPaymentsSource SupplierPayment[] @relation("SupplierPaymentSource")
  expenseCategoryFor     Expense[]         @relation("ExpenseCategory")
  expensePaymentsSource  Expense[]         @relation("ExpensePaymentSource")
  // Phase 9 — Cash, Bank, Loans & Fixed Assets.
  cashBankTxnDebits        CashBankTransaction[] @relation("CashBankTxnDebit")
  cashBankTxnCredits       CashBankTransaction[] @relation("CashBankTxnCredit")
  loanAccountFor           Loan[]                @relation("LoanAccount")
  loanDisbursements        Loan[]                @relation("LoanDisbursement")
  loanRepaymentsSource     LoanRepayment[]       @relation("LoanRepaymentSource")
  fixedAssetAccountFor     FixedAsset[]          @relation("FixedAssetAccount")
  fixedAssetPaymentsSource FixedAsset[]          @relation("FixedAssetPaymentSource")

  @@index([type])
  @@index([parentId])
  @@index([isActive])
}

/// One month of one financial year. An Indian FY runs 1 April - 31 March.
model FinancialPeriod {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// The FY's starting calendar year: FY 2026-27 is stored as 2026.
  financialYear Int

  /// 1-12 where 1 = April, so ordering by this is chronological within the
  /// financial year rather than the calendar year.
  periodNumber Int

  /// Display label, e.g. "Apr 2026".
  label     String
  startDate DateTime
  endDate   DateTime

  status     FinancialPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  closedBy   User?                 @relation("PeriodCloser", fields: [closedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries         JournalEntry[]
  stockValuation  StockValuation?

  @@unique([companyId, financialYear, periodNumber])
  @@index([startDate, endDate])
  @@index([status])
}

/// A balanced set of debits and credits. Immutable once POSTED: a mistake is
/// corrected by a linked reversing entry, never by editing these rows.
model JournalEntry {
  id          String   @id @default(cuid())
  entryNumber String   @unique
  entryDate   DateTime

  periodId String
  period   FinancialPeriod @relation(fields: [periodId], references: [id])

  narration String
  status    JournalEntryStatus @default(POSTED)

  sourceType JournalSourceType
  /// The business document this was generated from. Null for MANUAL entries.
  /// Not an FK — the source may be any of several tables.
  sourceId   String?

  /// Unique per logical posting, so a retried Server Action, a double submit
  /// or a replayed webhook cannot post the same document twice. Composed by
  /// the caller as sourceType:sourceId:revision.
  idempotencyKey String @unique

  /// Set on a reversing entry, pointing at what it reverses. One-to-one:
  /// an entry may be reversed only once.
  reversesEntryId String?       @unique
  reverses        JournalEntry? @relation("EntryReversal", fields: [reversesEntryId], references: [id])
  reversedBy      JournalEntry? @relation("EntryReversal")

  postedById String
  postedBy   User     @relation("JournalPoster", fields: [postedById], references: [id])
  postedAt   DateTime @default(now())

  createdAt DateTime @default(now())

  lines JournalLine[]

  @@index([entryDate])
  @@index([periodId])
  @@index([sourceType, sourceId])
  @@index([status])
}

/// One side of one entry. Exactly one of debit/credit is non-zero, and both
/// are non-negative — a negative amount is never used to mean "the other
/// side", because it would break every SUM-based report.
model JournalLine {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// Position within the entry, so a ledger prints lines in the order they
  /// were written rather than by cuid.
  lineNumber Int

  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])

  debit  Decimal @default(0) @db.Decimal(16, 2)
  credit Decimal @default(0) @db.Decimal(16, 2)

  narration String?

  partyType PartyType?
  partyId   String?

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([accountId])
  @@index([partyType, partyId])
}

/// Named links from a posting role to a real account, so no account id or
/// code is ever hardcoded at a call site. Seeded alongside the chart of
/// accounts and validated at boot; a missing mapping fails loudly rather
/// than silently posting somewhere plausible.
model AccountMapping {
  id String @id @default(cuid())

  /// e.g. AR_TRADE, SALES_REVENUE, GST_OUTPUT_CGST, ROUND_OFF.
  key String @unique

  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Gapless, per-financial-year document numbering.
///
/// Replaces the COUNT(*)+1 scheme in src/lib/id-sequences.ts for financial
/// documents. GST Rule 46(b) requires a consecutive serial number unique
/// within a financial year; a row count is neither gapless nor per-FY, and
/// races under concurrency. nextNumber is incremented under a row lock
/// inside the same transaction that inserts the document.
model DocumentSeries {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// SALES_INVOICE, RECEIPT, CREDIT_NOTE, JOURNAL, ...
  documentType  String
  financialYear Int

  prefix  String
  /// Zero-padding width of the numeric part.
  padding Int    @default(4)

  nextNumber Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, documentType, financialYear])
}

/// GST rate master, keyed by HSN.
///
/// Rates are data, never literals in code: Urvar's accountant owns these
/// values and organic-manure classification is rate-sensitive. The
/// effectiveFrom/To window keeps a historical invoice re-derivable after a
/// rate change.
model TaxRate {
  id          String  @id @default(cuid())
  hsnCode     String
  description String?

  treatment TaxTreatment @default(TAXABLE)

  /// Total GST percent. CGST/SGST is always half each and IGST is the full
  /// rate, so storing one number keeps intra- and inter-state consistent by
  /// construction rather than by three columns that can drift apart.
  ratePercent Decimal @db.Decimal(5, 2)
  cessPercent Decimal @default(0) @db.Decimal(5, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  /// False until a tax professional has signed the classification off. The
  /// tax engine refuses to price an invoice from an unverified row, so the
  /// system cannot quietly invent a rate — see the brief's rule that GST
  /// treatment is never assumed.
  isVerified   Boolean @default(false)
  verifiedNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hsnCode, effectiveFrom])
  @@index([isVerified])
}

// ============================================================
// ACCOUNTING — sales invoicing and receivables (Phase 2)
//
// The outbound chain used to stop at Order, which is a header carrying one
// totalAmount and no lines. These models complete it:
//   Quotation -> Order (+ items) -> SalesInvoice (+ items) -> Receipt
// with CreditNote for returns and corrections.
//
// Everything money-bearing is snapshotted at issue time. A product's name,
// HSN code or GST rate may change next quarter; a tax invoice issued today
// must stay exactly re-derivable, which the existing QuotationItem cannot do
// because it reads gstPercent live off Product.
// ============================================================

enum SalesInvoiceStatus {
  /// Editable, no ledger impact.
  DRAFT
  /// Posted to the ledger and immutable. Nothing paid yet.
  POSTED
  PARTIALLY_PAID
  PAID
  /// Reversed in the ledger. The row stays, the money is undone.
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

enum ReceiptStatus {
  POSTED
  CANCELLED
}

enum CreditNoteReason {
  SALES_RETURN
  RATE_DIFFERENCE
  SHORTAGE
  POST_SALE_DISCOUNT
  CANCELLATION
  OTHER
}

/// Line items for an Order.
///
/// The Order model shipped without any, so an accepted quotation produced a
/// header with a single totalAmount and nothing to invoice line-by-line from,
/// no per-product margin and no partial fulfilment. Nullable productId
/// mirrors PurchaseInvoiceItem: a historical order may reference a product
/// that has since been removed from the catalogue.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  /// Snapshot, so the line still reads correctly if the product is renamed.
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)

  /// How much of this line has been invoiced, for partial invoicing.
  quantityInvoiced Decimal @default(0) @db.Decimal(12, 2)

  lineNumber Int

  @@index([orderId])
}

/// A GST tax invoice.
model SalesInvoice {
  id            String  @id @default(cuid())
  invoiceNumber String  @unique
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// Provenance. Both optional: an invoice may be raised directly.
  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  invoiceDate DateTime
  dueDate     DateTime?

  /// Place of supply, captured at issue time rather than read from the
  /// customer later — a customer may move state, and that must not
  /// retrospectively change whether an old invoice was CGST+SGST or IGST.
  placeOfSupply String
  isInterState  Boolean
  customerGstin String?

  /// Seller identity as printed. Snapshotted for the same reason.
  sellerGstin String?
  sellerState String

  reverseCharge Boolean @default(false)

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  freightAmount  Decimal @default(0) @db.Decimal(12, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(14, 2)
  igstAmount     Decimal @default(0) @db.Decimal(14, 2)
  cessAmount     Decimal @default(0) @db.Decimal(14, 2)
  /// Sub-rupee adjustment shown as its own line on the invoice.
  roundOff       Decimal @default(0) @db.Decimal(6, 2)
  totalAmount    Decimal @default(0) @db.Decimal(14, 2)

  /// Workflow state. The authoritative paid amount is always the sum of
  /// ReceiptAllocation rows; this is kept in step inside the same transaction
  /// as an allocation, and a test asserts the two never disagree.
  status SalesInvoiceStatus @default(DRAFT)

  /// Migrated from Vyapar as an opening balance. Such an invoice posts to
  /// AR and Opening Balance Equity, never to revenue, and is excluded from
  /// the GST output registers — that revenue was recognised in Vyapar and is
  /// already in a filed return.
  isOpeningItem Boolean @default(false)

  notes              String?
  termsAndConditions String?

  /// The journal entry this invoice posted, once posted.
  postedEntryId String?   @unique
  postedAt      DateTime?
  cancelledAt   DateTime?

  createdById String
  createdBy   User   @relation("SalesInvoiceCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       SalesInvoiceItem[]
  allocations ReceiptAllocation[]
  creditNotes CreditNote[]

  @@index([customerId])
  @@index([status])
  @@index([invoiceDate])
  @@index([orderId])
}

/// One line of a tax invoice, with tax resolved and frozen per line.
model SalesInvoiceItem {
  id        String       @id @default(cuid())
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  /// All snapshots. QuotationItem stores none of these and reads gstPercent
  /// live off Product, which is why a historical quotation's tax cannot be
  /// reconstructed once a rate changes.
  description String
  hsnCode     String?
  unit        String

  quantity        Decimal @db.Decimal(12, 2)
  unitPrice       Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxableValue    Decimal @db.Decimal(14, 2)

  taxRatePercent Decimal @db.Decimal(5, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(14, 2)
  igstAmount     Decimal @default(0) @db.Decimal(14, 2)
  cessAmount     Decimal @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  /// Informational margin snapshot, never posted to the ledger — this CRM
  /// runs periodic (not perpetual) costing (see StockValuation above), so
  /// COGS reaches the P&L at period close, not per invoice. Null whenever the
  /// product has no purchase history yet to average a cost from; a null here
  /// must never be read as "cost is zero."
  estimatedUnitCost   Decimal? @db.Decimal(14, 4)
  estimatedCostAmount Decimal? @db.Decimal(14, 2)

  /// How much of this line has already been credited, mirroring
  /// OrderItem.quantityInvoiced exactly — without it a second credit note
  /// against the same line has no way to know a first one already used up
  /// part or all of the quantity, and could credit more than was ever sold.
  quantityCredited Decimal @default(0) @db.Decimal(12, 2)

  lineNumber Int

  @@index([invoiceId])
  @@index([productId])
}

/// Money received from a customer.
///
/// A receipt is not tied to one invoice: a customer pays an amount, and that
/// amount is then allocated across invoices. Modelling it the other way round
/// makes part-payments and on-account payments impossible to represent.
model Receipt {
  id            String  @id @default(cuid())
  receiptNumber String  @unique
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  receiptDate DateTime
  amount      Decimal  @db.Decimal(14, 2)

  method    PaymentMethod
  /// UTR, cheque number, UPI reference. Free text by necessity.
  reference String?

  /// Which cash or bank account the money landed in. A real account id rather
  /// than a mapping key, because a business may hold several bank accounts and
  /// the mapping only names the default.
  depositAccountId String
  depositAccount   LedgerAccount @relation("ReceiptDeposit", fields: [depositAccountId], references: [id])

  status ReceiptStatus @default(POSTED)
  notes  String?

  postedEntryId String?   @unique
  cancelledAt   DateTime?

  createdById String
  createdBy   User   @relation("ReceiptCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations ReceiptAllocation[]

  @@index([customerId])
  @@index([receiptDate])
  @@index([status])
}

/// How much of one receipt was applied to one invoice.
///
/// The sum of these per invoice is the authoritative paid amount; the sum per
/// receipt may be less than the receipt, and the remainder sits as an advance.
model ReceiptAllocation {
  id        String       @id @default(cuid())
  receiptId String
  receipt   Receipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id])

  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  /// One allocation row per (receipt, invoice) pair — a second application of
  /// the same receipt to the same invoice is an edit, not a new row.
  @@unique([receiptId, invoiceId])
  @@index([invoiceId])
}

/// A credit note against an issued invoice — sales return, rate difference,
/// shortage, or a post-sale discount.
///
/// Never a deletion or an edit of the original invoice: under GST the original
/// document stands and is adjusted by a separate credit note carrying its own
/// number and its own reversal of output tax.
model CreditNote {
  id               String  @id @default(cuid())
  creditNoteNumber String  @unique
  companyId        String
  company          Company @relation(fields: [companyId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// The invoice being adjusted. Optional only for an unlinked adjustment,
  /// which should be rare and is worth being able to spot.
  invoiceId String?
  invoice   SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  noteDate  DateTime
  reason    CreditNoteReason
  narration String?

  placeOfSupply String
  isInterState  Boolean

  subtotal    Decimal @default(0) @db.Decimal(14, 2)
  cgstAmount  Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount  Decimal @default(0) @db.Decimal(14, 2)
  igstAmount  Decimal @default(0) @db.Decimal(14, 2)
  cessAmount  Decimal @default(0) @db.Decimal(14, 2)
  roundOff    Decimal @default(0) @db.Decimal(6, 2)
  totalAmount Decimal @default(0) @db.Decimal(14, 2)

  postedEntryId String?   @unique
  postedAt      DateTime?
  /// Every other posted document (SalesInvoice, PurchaseInvoice, Expense,
  /// StockValuation) has this; CreditNote was missing it since Phase 2 —
  /// added so cancellation follows the same reversal-not-deletion path as
  /// everywhere else instead of having none at all.
  cancelledAt   DateTime?

  createdById String
  createdBy   User   @relation("CreditNoteCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CreditNoteItem[]

  @@index([customerId])
  @@index([invoiceId])
  @@index([noteDate])
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  description String
  hsnCode     String?
  unit        String

  quantity     Decimal @db.Decimal(12, 2)
  unitPrice    Decimal @db.Decimal(12, 2)
  taxableValue Decimal @db.Decimal(14, 2)

  taxRatePercent Decimal @db.Decimal(5, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(14, 2)
  igstAmount     Decimal @default(0) @db.Decimal(14, 2)
  cessAmount     Decimal @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  lineNumber Int

  @@index([creditNoteId])
}

// ============================================================
// ACCOUNTING — purchases and expenses (Phase 3)
//
// PurchaseInvoice already existed (the OCR-intake "photograph a supplier's
// invoice" flow) and is extended above rather than duplicated into a new
// SupplierBill model — it already is that document. What Phase 3 adds is
// what happens after it's captured: posting it to the ledger, paying it
// down, and a lighter-weight path for outgo that never runs through a
// supplier ledger at all.
//
// Deliberately deferred: purchase orders and goods-receipt notes. Neither
// concept exists anywhere in this schema today (unlike the sales side, where
// Order already existed before this work started), and inventing a PO/GRN
// workflow with no evidenced current usage would be speculative scope, not a
// gap-fill. See docs/ACCOUNTING_IMPLEMENTATION_PLAN.md.
// ============================================================

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  /// Posted and paid, in one step. Expenses here are the "petty cash paid
  /// same day" kind — rent, electricity, a courier bill — never on account.
  /// Outgo owed to a party for longer than that is a PurchaseInvoice, which
  /// already carries proper AP tracking; Expense deliberately does not
  /// duplicate that.
  APPROVED
  REJECTED
  CANCELLED
}

/// Money paid to a supplier, allocated across their invoices. Mirrors
/// Receipt/ReceiptAllocation on the AR side exactly, direction reversed.
model SupplierPayment {
  id            String  @id @default(cuid())
  paymentNumber String  @unique
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  paymentDate DateTime
  amount      Decimal  @db.Decimal(14, 2)

  method    PaymentMethod
  reference String?

  /// The cash/bank account the money left from.
  paymentAccountId String
  paymentAccount   LedgerAccount @relation("SupplierPaymentSource", fields: [paymentAccountId], references: [id])

  status ReceiptStatus @default(POSTED)
  notes  String?

  postedEntryId String?   @unique
  cancelledAt   DateTime?

  createdById String
  createdBy   User   @relation("SupplierPaymentCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations SupplierPaymentAllocation[]

  @@index([supplierId])
  @@index([paymentDate])
  @@index([status])
}

model SupplierPaymentAllocation {
  id        String          @id @default(cuid())
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id])

  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

/// A simple, immediately-paid outgo — rent, electricity, travel, a courier
/// bill. Approval and posting happen in the same step: APPROVED means paid,
/// not "owed and paid later" (see the enum's comment). `payeeName` is free
/// text rather than a Supplier FK on purpose — most expenses have no ongoing
/// account relationship worth a full supplier record.
model Expense {
  id            String  @id @default(cuid())
  expenseNumber String  @unique
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])

  expenseDate       DateTime
  categoryAccountId String
  categoryAccount   LedgerAccount @relation("ExpenseCategory", fields: [categoryAccountId], references: [id])

  payeeName   String
  description String?
  /// The grand total, whichever path produced it — a plain flat-amount
  /// expense (no items) or an itemised one (subtotal + transport + tax ±
  /// roundOff). Every existing reader (posting, audit, reports) keeps reading
  /// this one field regardless of which shape is underneath.
  amount      Decimal @db.Decimal(14, 2)

  /// True once this expense carries itemised GST-priced lines. A legacy
  /// flat-amount expense (no `items`, this false) keeps working exactly as
  /// before — the fields below all default to zero/false and are simply
  /// unused on that path.
  isGstApplicable Boolean @default(false)
  /// Whether this expense's GST may be claimed as Input Tax Credit. Defaults
  /// false on purpose: a blocked credit (Sec 17(5) — staff welfare, motor
  /// vehicles, etc.) claimed by default would be a real over-claim, not a
  /// rounding nicety, so a person must deliberately tick this on rather than
  /// every GST expense silently claiming credit.
  claimInputCredit Boolean @default(false)

  subtotal   Decimal @default(0) @db.Decimal(14, 2)
  cgstAmount Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount Decimal @default(0) @db.Decimal(14, 2)
  igstAmount Decimal @default(0) @db.Decimal(14, 2)
  /// The "Transportation" charge on the entry screen — posts to its own
  /// Freight Inward account, never folded into the expense's category.
  transportAmount Decimal @default(0) @db.Decimal(12, 2)
  roundOff        Decimal @default(0) @db.Decimal(6, 2)

  method           PaymentMethod
  /// The cash/bank account the money left from.
  paymentAccountId String
  paymentAccount   LedgerAccount @relation("ExpensePaymentSource", fields: [paymentAccountId], references: [id])

  status ExpenseStatus @default(DRAFT)

  submittedAt    DateTime?
  approvedById   String?
  approvedBy     User?     @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?

  postedEntryId String?   @unique
  cancelledAt   DateTime?

  createdById String
  createdBy   User   @relation("ExpenseCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       ExpenseItem[]
  attachments File[]

  @@index([status])
  @@index([expenseDate])
  @@index([categoryAccountId])
}

/// One line of an itemised expense — description, qty, price, and this
/// line's own tax rate. The rate is picked directly (a 0/5/12/18/28 dropdown
/// on the entry screen), never resolved through `resolveTaxRate()`'s
/// verified-HSN gate the sales side uses: on a sale, the rate is a
/// classification decision this company is liable for, so an unverified HSN
/// blocks pricing; on an expense, the rate is a transcription of whatever the
/// supplier's own bill already shows, and most expense lines (rent, courier,
/// electricity) carry no HSN at all.
model ExpenseItem {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  description String

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)

  taxRatePercent Decimal @default(0) @db.Decimal(5, 2)
  taxableValue   Decimal @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  lineNumber Int

  @@index([expenseId])
}

// ============================================================
// COSTING — periodic inventory valuation (Phase 4)
//
// The CRM does not track on-hand stock quantity — that lives in the ERP
// (urvar_erp), read-only, and reading it live requires a postgres_fdw wire-up
// across two production databases that has never actually been applied (see
// docs/ACCOUNTING_IMPLEMENTATION_PLAN.md). So this is deliberately a
// *periodic* costing model, the same one Vyapar and Tally use for a trading
// business: Purchases already post straight to the P&L Purchases account
// (src/lib/accounting/purchase-posting.ts) rather than to an inventory asset,
// so COGS for the period is Opening Stock + Purchases - Closing Stock, and
// Closing Stock is a period-end adjustment, not a per-invoice ledger entry.
//
// A human enters the on-hand quantity per product at period end (from a
// physical count or an ERP report) — never invented or estimated by this
// system. Unit cost is a weighted average of everything purchased to date
// (src/lib/accounting/costing.ts), computed from PurchaseInvoiceItem, which
// is the honest approximation available without a perpetual stock ledger.
// ============================================================

enum StockValuationStatus {
  /// Being prepared; quantities and costs can still change.
  DRAFT
  /// Posted to the ledger: Dr Inventory, Cr COGS for the closing value, after
  /// reversing whichever earlier valuation it supersedes (so last period's
  /// closing stock becomes this period's opening stock, exactly as a manual
  /// trading-account close would do it).
  POSTED
  CANCELLED
}

/// One period's closing-stock valuation. `periodId` is unique — a period is
/// valued at most once; correcting a mistake cancels this one (which reverses
/// its entry) and a new valuation is created, never edited in place once
/// posted.
model StockValuation {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  periodId      String          @unique
  period        FinancialPeriod @relation(fields: [periodId], references: [id])
  valuationDate DateTime

  totalValue Decimal @db.Decimal(14, 2)
  /// Where the quantities came from — a physical count, an ERP stock report
  /// printout, etc. Free text because the source is a human's statement, not
  /// a system fact this code can verify.
  notes      String?

  status        StockValuationStatus @default(DRAFT)
  postedEntryId String?              @unique
  postedAt      DateTime?
  cancelledAt   DateTime?

  createdById String
  createdBy   User     @relation("StockValuationCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines StockValuationLine[]

  @@index([companyId])
  @@index([status])
}

/// One product's quantity and cost within a valuation. `unitCost` carries
/// more precision than a money amount (4dp, not 2) because a weighted average
/// over many purchases is rarely a round paisa figure, and truncating it to
/// 2dp before multiplying by quantity would compound into a real error at
/// scale.
model StockValuationLine {
  id          String         @id @default(cuid())
  valuationId String
  valuation   StockValuation @relation(fields: [valuationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])

  quantityOnHand Decimal @db.Decimal(12, 2)
  unitCost       Decimal @db.Decimal(14, 4)
  /// "WEIGHTED_AVERAGE" (computed from purchase history) or "MANUAL" (typed
  /// in directly, because the product has no purchase history to average —
  /// never silently defaulted to zero or another product's cost).
  costSource     String
  value          Decimal @db.Decimal(14, 2)

  @@unique([valuationId, productId])
  @@index([valuationId])
}

// ============================================================
// CASH, BANK, LOANS & FIXED ASSETS (Phase 9)
//
// Same document→posting pattern as every model above: a business record is
// created, then a separate posting step (posting.ts) emits the balanced
// entry and stores postedEntryId; cancellation reverses the entry and stamps
// cancelledAt. Nothing here writes JournalLine directly.
//
// Loans and fixed assets are deliberately sub-ledgers, not one LedgerAccount
// per loan/asset — the same design AR/AP already uses (1130 Accounts
// Receivable is one control account; per-customer detail lives on
// JournalLine.partyType/partyId). Traceability here comes from
// JournalEntry.sourceType + sourceId pointing at the register row instead,
// since PartyType has no LOAN/ASSET member.
// ============================================================

enum CashBankTxnType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  BANK_CHARGE
  INTEREST_INCOME
  CASH_ADJUSTMENT
}

/// A cash/bank movement not already captured by a Receipt, Expense or
/// SupplierPayment: deposits, withdrawals, inter-account transfers, bank
/// charges, interest income, and a physical cash-count correction.
/// `debitAccountId`/`creditAccountId` are the actual posting sides — this
/// model reads the same way a JournalLine does rather than inventing
/// "from"/"to" vocabulary the rest of the system doesn't use; `type` is a
/// reporting label, not a branch in the posting logic.
model CashBankTransaction {
  id      String          @id @default(cuid())
  type    CashBankTxnType
  txnDate DateTime

  debitAccountId  String
  debitAccount    LedgerAccount @relation("CashBankTxnDebit", fields: [debitAccountId], references: [id])
  creditAccountId String
  creditAccount   LedgerAccount @relation("CashBankTxnCredit", fields: [creditAccountId], references: [id])

  amount    Decimal @db.Decimal(14, 2)
  reference String?
  notes     String?

  postedEntryId String?   @unique
  cancelledAt   DateTime?

  createdById String
  createdBy   User     @relation("CashBankTxnCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([txnDate])
  @@index([type])
}

enum LoanStatus {
  ACTIVE
  /// Principal fully repaid — the backing ledger account reads exactly zero.
  CLOSED
  /// Recorded in error; the disbursement entry has been reversed.
  CANCELLED
}

/// One borrowing. `outstandingPrincipal` is deliberately NOT a column — it is
/// derived (principal minus the sum of POSTED repayments' principal portion)
/// and must equal the ledger balance of `loanAccount`, the same rule every
/// other balance in this system follows. The amortisation schedule itself is
/// derived at read time from these terms (see loan-schedule.ts) rather than
/// stored, so it can never drift from them.
model Loan {
  id         String @id @default(cuid())
  lenderName String
  /// The lender's own reference/account number, for reconciling against
  /// their statement. Free text — it is their identifier, not ours.
  lenderReference String?

  /// This loan's own liability account, a child of the Loans group — see the
  /// plan's note on why loans (few, named, accountant-created, reconciled
  /// against an external statement) sit at the opposite end of the
  /// sub-ledger-vs-account axis from fixed assets.
  loanAccountId String        @unique
  loanAccount   LedgerAccount @relation("LoanAccount", fields: [loanAccountId], references: [id])

  /// Where the drawdown landed, and the default source for instalments.
  disbursedToAccountId String
  disbursedToAccount   LedgerAccount @relation("LoanDisbursement", fields: [disbursedToAccountId], references: [id])

  principal         Decimal @db.Decimal(14, 2)
  /// Annual nominal rate, percent. 3dp: a real bank rate like 10.499% needs
  /// more precision than TaxRate.ratePercent's (5,2).
  annualRatePercent Decimal @db.Decimal(6, 3)
  tenureMonths      Int
  startDate         DateTime

  /// The instalment the LENDER quoted. Entered, not computed — the schedule
  /// is amortised from this number so it reproduces the lender's own
  /// schedule rather than disagreeing with it by a rounding convention.
  emiAmount Decimal @db.Decimal(14, 2)

  status LoanStatus @default(ACTIVE)

  disbursementEntryId String?   @unique
  closedAt             DateTime?
  cancelledAt          DateTime?
  notes                String?

  createdById String
  createdBy   User     @relation("LoanCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repayments LoanRepayment[]

  @@index([status])
}

/// One recorded EMI (or prepayment) against a loan. The schedule this pays
/// against is derived, not stored, so `installmentNumber` is the join key
/// back to it rather than a foreign key to a schedule row.
model LoanRepayment {
  id                String   @id @default(cuid())
  loanId            String
  loan              Loan     @relation(fields: [loanId], references: [id])
  installmentNumber Int
  paidDate          DateTime

  totalPaid        Decimal @db.Decimal(14, 2)
  principalPortion Decimal @db.Decimal(14, 2)
  interestPortion  Decimal @db.Decimal(14, 2)

  paidFromAccountId String
  paidFromAccount   LedgerAccount @relation("LoanRepaymentSource", fields: [paidFromAccountId], references: [id])

  postedEntryId String?   @unique
  cancelledAt   DateTime?

  createdById String
  createdBy   User     @relation("LoanRepaymentCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  /// A cancelled repayment must leave the instalment payable again. This is
  /// deliberately NOT a `@@unique([loanId, installmentNumber])` — rows are
  /// never deleted (only `cancelledAt` stamped), so a hard DB unique would
  /// mean a cancelled repayment permanently bricks that instalment number,
  /// since the cancelled row still occupies the constraint. Postgres partial
  /// unique indexes (only where `cancelledAt IS NULL`) aren't expressible in
  /// schema.prisma, so "at most one ACTIVE repayment per instalment" is
  /// enforced in `loans.ts` instead, inside the same transaction as the insert.
  @@index([loanId, installmentNumber])
  @@index([loanId])
}

enum FixedAssetStatus {
  ACTIVE
  /// Sold, scrapped or written off. Excluded from every later depreciation run.
  DISPOSED
  /// Recorded in error; its acquisition entry has been reversed.
  CANCELLED
}

/// One asset in the fixed-asset register — a SUB-LEDGER: cost sits in the
/// shared category account (1210/1220/1230) and accumulated depreciation in
/// 1290, so the chart of accounts does not grow by one row per chair.
/// Per-asset carrying amount is derived (cost minus Σ POSTED
/// DepreciationEntry.amount for this asset), never stored.
model FixedAsset {
  id   String @id @default(cuid())
  name String

  assetAccountId String
  assetAccount   LedgerAccount @relation("FixedAssetAccount", fields: [assetAccountId], references: [id])

  purchaseDate            DateTime
  /// Capitalised cost: purchase price plus freight/installation if included.
  /// GST claimed as ITC is never part of this.
  cost                    Decimal  @db.Decimal(14, 2)
  /// Annual WDV rate, percent, 3dp.
  depreciationRatePercent Decimal  @db.Decimal(6, 3)
  /// Depreciation never takes the asset below this.
  salvageValue            Decimal  @default(0) @db.Decimal(14, 2)

  /// Exactly one of these two is set — cash/bank purchase, or capitalised out
  /// of an already-posted PurchaseInvoice. See the plan's note on why the
  /// on-credit path reclassifies off PURCHASES rather than crediting AP
  /// directly (accountsPayableAgeing() reconstructs AP from PurchaseInvoice
  /// rows only, so a credit with no invoice behind it would never appear in
  /// AP ageing or the supplier's statement).
  paidFromAccountId       String?
  paidFromAccount         LedgerAccount?   @relation("FixedAssetPaymentSource", fields: [paidFromAccountId], references: [id])
  sourcePurchaseInvoiceId String?          @unique
  sourcePurchaseInvoice   PurchaseInvoice? @relation(fields: [sourcePurchaseInvoiceId], references: [id])

  status        FixedAssetStatus @default(ACTIVE)
  postedEntryId String?          @unique

  disposalDate     DateTime?
  disposalProceeds Decimal?  @db.Decimal(14, 2)
  disposalEntryId  String?   @unique
  disposalNotes    String?
  cancelledAt      DateTime?

  createdById String
  createdBy   User     @relation("FixedAssetCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  depreciationEntries DepreciationEntry[]

  @@index([status])
  @@index([assetAccountId])
}

/// One financial year's WDV depreciation charge for one asset. "A year can
/// only be depreciated once" is enforced in `fixed-assets.ts`'s
/// `postDepreciation()`, in the same transaction as the insert — NOT a
/// `@@unique([fixedAssetId, financialYear])`. Rows are never deleted (only
/// `cancelledAt` stamped), so a hard DB unique would mean a cancelled entry
/// permanently blocks re-depreciating that year, the exact same trap
/// `LoanRepayment`'s own comment documents and this schema hit for real in
/// testing before the fix.
model DepreciationEntry {
  id            String @id @default(cuid())
  fixedAssetId  String
  fixedAsset    FixedAsset @relation(fields: [fixedAssetId], references: [id])
  financialYear Int

  openingWdv Decimal @db.Decimal(14, 2)
  amount     Decimal @db.Decimal(14, 2)
  closingWdv Decimal @db.Decimal(14, 2)

  postedEntryId String?   @unique
  cancelledAt   DateTime?

  createdById String
  createdBy   User     @relation("DepreciationEntryCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([fixedAssetId, financialYear])
  @@index([fixedAssetId])
}
