// Urvar Natural CRM — Prisma 7 schema
// Generator uses the new `prisma-client` provider (Prisma 7) with an explicit output.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  DISTRIBUTOR_MANAGER
  ACCOUNTS_TEAM
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  META_ADS
  GOOGLE_ADS
  TRADE_SHOW
  REFERRAL
  DISTRIBUTOR
  DIRECT_CALL
  WHATSAPP
  ORGANIC_SEARCH
  GOVERNMENT_TENDER
  OTHER
}

enum CustomerType {
  B2C_FARMER
  B2B_RETAILER
  B2B_DEALER
  B2B_DISTRIBUTOR
  AGRI_INPUT_SHOP
  FPO_COOPERATIVE
  NGO
  GOVERNMENT
  CORPORATE_FARM
  PLANTATION
}

enum DealerTier {
  GOLD
  SILVER
  BRONZE
}

enum PipelineStage {
  NEW_LEAD
  FIRST_CONTACT
  REQUIREMENT_GATHERING
  PRODUCT_DISCUSSION
  SAMPLE_SENT
  QUOTATION_SENT
  NEGOTIATION
  ORDER_RECEIVED
  WON
  LOST
}

enum ActivityType {
  NOTE
  STATUS_CHANGE
  STAGE_CHANGE
  CALL_LOGGED
  FOLLOWUP_LOGGED
  FOLLOWUP_COMPLETED
  TASK_CREATED
  QUOTATION_CREATED
  QUOTATION_SENT
  LEAD_ASSIGNED
  LEAD_CONVERTED
  FILE_ATTACHED
  EMAIL_SENT
  WHATSAPP_SENT
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallOutcome {
  CONNECTED
  NOT_REACHABLE
  BUSY
  INTERESTED
  FOLLOW_UP_REQUIRED
  QUOTATION_REQUESTED
  CONVERTED
  WRONG_NUMBER
  TRANSFERRED_TO_HUMAN
}

enum CallProvider {
  MANUAL
  TWILIO
  PLIVO
}

// AI Voice Agent: whether a call is fully human, human-driven with a passive
// AI transcript/suggestion overlay, or fully AI-driven (no human on the line).
enum CallMode {
  HUMAN
  AI_ASSISTED
  AI_AUTONOMOUS
}

enum CallSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  ESCALATED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ProductCategory {
  VERMICOMPOST
  PROM
  HUMIC_ACID
  ORGANIC_FERTILIZER
  MICRONUTRIENT
  SOIL_CONDITIONER
  BIO_FERTILIZER
  CROP_NUTRITION
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum NotificationType {
  FOLLOWUP_DUE
  LEAD_ASSIGNED
  QUOTATION_RESPONSE
  TASK_ASSIGNED
  TASK_DUE
  STAGE_CHANGE
  GENERAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

/// Why an outbound message was sent. Separate from NotificationType, which
/// describes an in-app notification's subject: a MessageLog row is a record of
/// something that left the building over EMAIL or WHATSAPP.
enum MessagePurpose {
  QUOTATION_SENT
  FOLLOWUP_REMINDER
  GENERAL
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum FileCategory {
  QUOTATION_PDF
  ATTACHMENT
  FIELD_VISIT_PHOTO
}

// ============================================================
// AUTH (Better Auth core models + app fields on User)
// ============================================================

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // App-specific fields
  role            Role      @default(SALES_EXECUTIVE)
  phone           String?
  territoryStates String[]  @default([])
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?

  // Plivo Voice: persistent SIP Endpoint credentials for in-browser calling,
  // created lazily on first call and reused (unlike Twilio's ephemeral tokens).
  plivoEndpointId        String?
  plivoUsername          String? @unique
  plivoPasswordEncrypted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // App relations
  ownedLeads              Lead[]                 @relation("LeadOwner")
  ownedCustomers          Customer[]             @relation("CustomerOwner")
  calls                   Call[]
  transferredCalls        Call[]                 @relation("CallTransferredTo")
  followUps               FollowUp[]
  assignedTasks           Task[]                 @relation("TaskAssignee")
  createdTasks            Task[]                 @relation("TaskCreator")
  createdQuotations       Quotation[]            @relation("QuotationCreator")
  createdOrders           Order[]                @relation("OrderCreator")
  createdSuppliers        Supplier[]             @relation("SupplierCreator")
  createdPurchaseInvoices PurchaseInvoice[]      @relation("PurchaseInvoiceCreator")
  leadActivities          LeadActivity[]
  pipelineMoves           PipelineStageHistory[]
  uploadedFiles           File[]
  notifications           Notification[]
  sentMessages            MessageLog[]
  fieldVisits             FieldVisit[]
  auditLogs               AuditLog[]
  postedEntries           JournalEntry[]         @relation("JournalPoster")
  closedPeriods           FinancialPeriod[]      @relation("PeriodCloser")

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ============================================================
// CRM CORE
// ============================================================

model Lead {
  id            String       @id @default(cuid())
  leadNumber    String       @unique
  name          String
  companyName   String?
  contactPerson String?
  phone         String
  whatsapp      String?
  altPhone      String?
  email         String?
  state         String
  district      String
  pincode       String?
  address       String?
  source        LeadSource   @default(DIRECT_CALL)
  status        LeadStatus   @default(NEW)
  customerType  CustomerType @default(B2C_FARMER)

  interestedProducts   String?
  expectedQuantity     String?
  expectedMonthlyValue Decimal? @db.Decimal(12, 2)
  estimatedValue       Decimal? @db.Decimal(12, 2)
  cropInterest         String?
  isGovernmentTender   Boolean  @default(false)
  remarks              String?
  lostReason           String?

  // AI Voice Agent: opt-out enforced by the outbound campaign scheduler (Phase 3)
  doNotCall       Boolean @default(false)
  doNotCallReason String?

  // Phase-2 hooks (free, nullable)
  whatsappOptIn     Boolean?
  leadScore         Int?
  // BCP-47 code (e.g. "bn-IN") of the language AI calls to this lead should
  // open in, overriding the Lead.state guess in tts-language.ts (a proxy,
  // wrong for anyone who has moved states). Null means "use the state".
  // Set by a rep in the lead form — deliberately NOT written by the voice
  // agent: auto-detecting it from one utterance per call stored Telugu for a
  // West Bengal farmer off the mis-heard "Ice cream", and nothing in the UI
  // showed it. Mirrors the (still unused) Customer.preferredLanguage.
  preferredLanguage String?

  assignedToId String?
  assignedTo   User?   @relation("LeadOwner", fields: [assignedToId], references: [id])

  convertedCustomer Customer? @relation("LeadConversion")
  convertedAt       DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipeline      Pipeline?
  activities    LeadActivity[]
  calls         Call[]
  followUps     FollowUp[]
  tasks         Task[]
  quotations    Quotation[]
  orders        Order[]
  notifications Notification[]
  messageLogs   MessageLog[]
  fieldVisits   FieldVisit[]
  files         File[]

  @@index([status])
  @@index([state])
  @@index([assignedToId])
  @@index([createdAt])
}

model Pipeline {
  id                String        @id @default(cuid())
  leadId            String        @unique
  lead              Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage             PipelineStage @default(NEW_LEAD)
  enteredStageAt    DateTime      @default(now())
  expectedCloseDate DateTime?
  probability       Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  stageHistory PipelineStageHistory[]

  @@index([stage])
}

model PipelineStageHistory {
  id         String         @id @default(cuid())
  pipelineId String
  pipeline   Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  fromStage  PipelineStage?
  toStage    PipelineStage
  movedById  String
  movedBy    User           @relation(fields: [movedById], references: [id])
  movedAt    DateTime       @default(now())

  @@index([pipelineId])
}

model LeadActivity {
  id          String       @id @default(cuid())
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        ActivityType
  description String
  metadata    Json?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([leadId, createdAt])
}

model Call {
  id              String        @id @default(cuid())
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Nullable: an AI_AUTONOMOUS call (Phase 2+) has no human on the line.
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  direction       CallDirection @default(OUTBOUND)
  outcome         CallOutcome?
  durationSeconds Int?
  notes           String?
  calledAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())

  // Provider Voice (in-browser calling) fields — null/MANUAL for Sprint 2 manual logs
  provider        CallProvider @default(MANUAL)
  providerCallSid String?      @unique
  providerStatus  String?
  recordingUrl    String?
  recordingSid    String?
  fromNumber      String?
  toNumber        String?

  // AI Voice Agent (Phase 0+): AI transcript/outcome metadata, supplementary
  // to the human-picked outcome/notes above — never overwrites them.
  callMode       CallMode       @default(HUMAN)
  transcript     Json?
  /// Structured extraction of the call: crop, acreage, quantity, objections,
  /// purchase intent, next action. A free-text summary reads well but cannot
  /// be queried or fed back into the next call's prompt; this can.
  aiStructured   Json?
  /// Per-call latency and audio-transport telemetry — see
  /// voice-agent/pipeline/turn-metrics.ts. Stored per call rather than per
  /// turn: the write piggybacks on the update finalizeSession already makes,
  /// and a call's turns are always read together anyway.
  aiMetrics      Json?
  aiSummary      String?
  aiSentiment    CallSentiment?
  aiIntentTags   String[]       @default([])
  aiAgentVersion String?

  // Live-transfer handoff target (Phase 2)
  transferredToUserId String?
  transferredToUser   User?   @relation("CallTransferredTo", fields: [transferredToUserId], references: [id])

  // Flag-for-callback handoff (Phase 2): the FollowUp task the AI created
  followUpId String?   @unique
  followUp   FollowUp? @relation(fields: [followUpId], references: [id])

  @@index([leadId])
  @@index([customerId])
  @@index([userId, calledAt])
  @@index([callMode])
}

model FollowUp {
  id             String         @id @default(cuid())
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedToId   String
  assignedTo     User           @relation(fields: [assignedToId], references: [id])
  dueAt          DateTime
  priority       TaskPriority   @default(MEDIUM)
  status         FollowUpStatus @default(PENDING)
  notes          String?
  completedAt    DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // AI Voice Agent (Phase 2): the call that flagged this callback, if any
  call Call?

  @@index([assignedToId, dueAt])
  @@index([status])
}

model Task {
  id                String       @id @default(cuid())
  title             String
  description       String?
  assignedToId      String
  assignedTo        User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedById      String
  assignedBy        User         @relation("TaskCreator", fields: [assignedById], references: [id])
  relatedLeadId     String?
  relatedLead       Lead?        @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)
  relatedCustomerId String?
  relatedCustomer   Customer?    @relation(fields: [relatedCustomerId], references: [id], onDelete: SetNull)
  dueAt             DateTime?
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(OPEN)
  completedAt       DateTime?
  /// Set once the due-reminder cron has emailed/notified the assignee, so a
  /// task that stays open past its due date is not re-reminded every tick.
  /// Mirrors FollowUp.reminderSentAt.
  reminderSentAt    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([assignedToId, status])
  /// The due-reminder cron scans on dueAt + reminderSentAt, not assignee.
  @@index([status, dueAt])
}

model Customer {
  id             String       @id @default(cuid())
  customerNumber String       @unique
  name           String
  companyName    String?
  contactPerson  String?
  customerType   CustomerType @default(B2C_FARMER)
  phone          String
  whatsapp       String?
  altPhone       String?
  email          String?
  state          String
  district       String
  pincode        String?
  address        String?
  latitude       Float?
  longitude      Float?
  gstNumber      String?
  panNumber      String?

  creditLimit       Decimal? @db.Decimal(12, 2)
  outstandingAmount Decimal  @default(0) @db.Decimal(12, 2)
  annualPurchase    Decimal? @db.Decimal(14, 2)

  // Distributor / Dealer-specific (nullable)
  dealerTier        DealerTier?
  territoryAssigned String?
  annualTargetValue Decimal?    @db.Decimal(14, 2)

  // Phase-2 hooks
  preferredLanguage String?

  assignedToId String?
  assignedTo   User?   @relation("CustomerOwner", fields: [assignedToId], references: [id])

  sourceLeadId String? @unique
  sourceLead   Lead?   @relation("LeadConversion", fields: [sourceLeadId], references: [id])

  isActive Boolean @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls         Call[]
  followUps     FollowUp[]
  tasks         Task[]
  quotations    Quotation[]
  orders        Order[]
  notifications Notification[]
  messageLogs   MessageLog[]
  fieldVisits   FieldVisit[]
  files         File[]

  @@index([customerType])
  @@index([state])
  @@index([assignedToId])
}

model Product {
  id               String          @id @default(cuid())
  sku              String          @unique
  name             String
  category         ProductCategory
  hsnCode          String?
  description      String?
  unit             String
  packSize         String?
  mrp              Decimal         @db.Decimal(12, 2)
  dealerPrice      Decimal?        @db.Decimal(12, 2)
  distributorPrice Decimal?        @db.Decimal(12, 2)
  gstPercent       Decimal         @default(5) @db.Decimal(5, 2)
  isActive         Boolean         @default(true)

  // Agronomy facts the AI voice agent needs to hold a real conversation with
  // a farmer. Before these existed it could quote a pack size and a price and
  // nothing else, so "কত দিতে হবে বিঘা প্রতি?" — the first question anyone
  // actually asks — had no answer.
  //
  // All nullable and all authored by Urvar's own agronomist. An unfilled
  // field makes the agent say it will confirm and call back, which is the
  // correct behaviour: a wrong dosage told to a farmer is not a UX problem,
  // it is a ruined crop, so nothing here may ever be inferred by a model.
  targetCrops       String?
  problemSolved     String?
  dosage            String?
  applicationMethod String?
  nutrientContent   String?
  benefits          String?
  /// Rep-facing notes for common pushback on this specific product.
  objectionNotes    String?
  availability      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotationItems QuotationItem[]
  purchaseItems  PurchaseInvoiceItem[]

  @@index([category])
}

model Quotation {
  id                 String          @id @default(cuid())
  quotationNumber    String          @unique
  leadId             String?
  lead               Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdById        String
  createdBy          User            @relation("QuotationCreator", fields: [createdById], references: [id])
  status             QuotationStatus @default(DRAFT)
  validUntil         DateTime?
  subtotal           Decimal         @default(0) @db.Decimal(14, 2)
  discountPercent    Decimal         @default(0) @db.Decimal(5, 2)
  discountAmount     Decimal         @default(0) @db.Decimal(14, 2)
  freightAmount      Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(14, 2)
  totalAmount        Decimal         @default(0) @db.Decimal(14, 2)
  termsAndConditions String?
  notes              String?
  sentAt             DateTime?
  respondedAt        DateTime?
  /// Phase 6 of the sales-funnel automation roadmap: an unguessable bearer
  /// token minted when a quotation moves to SENT, letting the customer
  /// accept it via an emailed link (src/app/api/quotations/accept/[token])
  /// with no CRM session. Nullable because DRAFT quotations, and any
  /// quotation sent before this shipped, have none.
  acceptToken        String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items       QuotationItem[]
  order       Order?
  files       File[]
  messageLogs MessageLog[]

  @@index([status])
  @@index([customerId])
  @@index([createdById])
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  description     String?
  quantity        Decimal   @db.Decimal(12, 2)
  unitPrice       Decimal   @db.Decimal(12, 2)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal   @db.Decimal(14, 2)

  @@index([quotationId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  quotationId   String?       @unique
  quotation     Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  leadId        String?
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  totalAmount   Decimal       @db.Decimal(14, 2)
  status        OrderStatus   @default(CONFIRMED)
  paymentStatus PaymentStatus @default(PENDING)
  // Denormalized from customer for fast territory-revenue dashboard queries
  state         String
  district      String
  orderedAt     DateTime      @default(now())
  deliveredAt   DateTime?
  createdById   String
  createdBy     User          @relation("OrderCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
  @@index([state])
  @@index([orderedAt])
}

model Notification {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  channel           NotificationChannel @default(IN_APP)
  title             String
  body              String?
  relatedLeadId     String?
  relatedLead       Lead?               @relation(fields: [relatedLeadId], references: [id], onDelete: Cascade)
  relatedCustomerId String?
  relatedCustomer   Customer?           @relation(fields: [relatedCustomerId], references: [id], onDelete: Cascade)
  isRead            Boolean             @default(false)
  createdAt         DateTime            @default(now())

  @@index([userId, isRead])
}

/// A record of an outbound message that actually left the building — email or
/// WhatsApp — to a lead or customer. Notification (above) is the in-app
/// inbox for our own staff; this is the ledger of what we sent to the outside
/// world, including failures, so "did the customer ever get the quotation?"
/// has an answer that does not depend on the provider's own dashboard.
///
/// Attaches to either a Lead or a Customer, never both, exactly like Call.
model MessageLog {
  id          String     @id @default(cuid())
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The quotation this message was about, when it was about one.
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  /// Null for a message the due-reminder cron sent with no human behind it.
  sentById    String?
  sentBy      User?      @relation(fields: [sentById], references: [id])

  channel   NotificationChannel
  purpose   MessagePurpose
  /// The address or number actually dialled/mailed, captured as sent rather
  /// than re-read off the lead/customer later, which may have since changed.
  recipient String
  /// Email subject, or the WhatsApp template name for a template message.
  subject   String?

  status            MessageDeliveryStatus @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime              @default(now())
  deliveredAt       DateTime?

  @@index([leadId])
  @@index([customerId])
  @@index([quotationId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model File {
  id                       String           @id @default(cuid())
  fileName                 String
  filePath                 String
  mimeType                 String
  sizeBytes                Int
  category                 FileCategory     @default(ATTACHMENT)
  relatedLeadId            String?
  relatedLead              Lead?            @relation(fields: [relatedLeadId], references: [id], onDelete: Cascade)
  relatedCustomerId        String?
  relatedCustomer          Customer?        @relation(fields: [relatedCustomerId], references: [id], onDelete: Cascade)
  relatedQuotationId       String?
  relatedQuotation         Quotation?       @relation(fields: [relatedQuotationId], references: [id], onDelete: Cascade)
  // The scanned supplier invoice this record was created from.
  relatedPurchaseInvoiceId String?
  relatedPurchaseInvoice   PurchaseInvoice? @relation(fields: [relatedPurchaseInvoiceId], references: [id], onDelete: Cascade)
  // A photo taken at a field visit (shop front, crop, site).
  relatedFieldVisitId      String?
  relatedFieldVisit        FieldVisit?      @relation(fields: [relatedFieldVisitId], references: [id], onDelete: Cascade)
  uploadedById             String
  uploadedBy               User             @relation(fields: [uploadedById], references: [id])
  createdAt                DateTime         @default(now())

  @@index([relatedQuotationId])
  @@index([relatedLeadId])
  @@index([relatedCustomerId])
  @@index([relatedPurchaseInvoiceId])
  @@index([relatedFieldVisitId])
}

/// A rep's visit to a lead or customer in the field, captured on their phone.
///
/// The coordinates live here rather than on the lead/customer because they
/// answer a different question: Customer.latitude/longitude is where the shop
/// *is*, while this is where the rep *was*, at a time, on one occasion. A Lead
/// has no location columns at all, so for leads this is the only spatial
/// record there is.
///
/// checkOut* stay null while a visit is open — at most one open visit per rep
/// at a time, enforced in the check-in action rather than by constraint.
model FieldVisit {
  id         String    @id @default(cuid())
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id])

  checkInAt       DateTime @default(now())
  checkInLat      Float
  checkInLng      Float
  /// Metres of uncertainty the browser reported, kept so a wildly imprecise
  /// fix (a desktop on wifi) is distinguishable from a real GPS one.
  checkInAccuracy Float?

  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files File[]

  @@index([leadId])
  @@index([customerId])
  @@index([userId, checkInAt])
}

/// Procurement — the inbound side of the business. Everything else in this
/// schema is outbound (Quotation -> Order); these three models are the only
/// record of what Urvar buys, and exist so a scanned supplier invoice has
/// somewhere to land. Visible to SUPER_ADMIN and ACCOUNTS_TEAM only: supplier
/// prices reveal margin, so the `purchases` module grants sales roles nothing.
model Supplier {
  id            String            @id @default(cuid())
  supplierCode  String            @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  gstNumber     String?
  address       String?
  state         String?
  district      String?
  isActive      Boolean           @default(true)
  notes         String?
  invoices      PurchaseInvoice[]
  createdById   String
  createdBy     User              @relation("SupplierCreator", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([name])
}

model PurchaseInvoice {
  id            String                @id @default(cuid())
  /// The supplier's own invoice number, not ours — so it is unique per
  /// supplier rather than globally. Two suppliers may both issue "INV-001".
  invoiceNumber String
  supplierId    String
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  invoiceDate   DateTime
  subtotal      Decimal               @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal               @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal               @db.Decimal(14, 2)
  notes         String?
  items         PurchaseInvoiceItem[]
  files         File[]
  createdById   String
  createdBy     User                  @relation("PurchaseInvoiceCreator", fields: [createdById], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  /// Re-entering the same invoice for the same supplier is a mistake, and
  /// the likeliest one when invoices are captured by photographing them.
  @@unique([supplierId, invoiceNumber])
  @@index([invoiceDate])
}

model PurchaseInvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Optional, unlike QuotationItem.productId: a supplier invoice lists what
  /// THEY sell, which often will not match a row in our Product catalogue.
  /// Forcing a match would make such an invoice impossible to record, so the
  /// raw `description` is always kept and the link is made when it can be.
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id])
  description String
  quantity    Decimal         @db.Decimal(12, 2)
  unitPrice   Decimal         @db.Decimal(12, 2)
  lineTotal   Decimal         @db.Decimal(14, 2)

  @@index([invoiceId])
}

// ============================================================
// ACCOUNTING — double-entry foundation (Phase 1)
//
// Design rule for everything below: a financial document is a business
// record, and posting is a separate, centralized step that emits a balanced
// JournalEntry. Documents never write GL rows themselves and never store a
// balance — every balance is derived from posted JournalLines. See
// src/lib/accounting/posting.ts, the only module permitted to write here.
//
// Deliberately NOT multi-tenant at the ledger level. Company scopes the
// things that genuinely belong to a legal entity (periods, numbering), but
// LedgerAccount and JournalEntry are not company-scoped: Urvar is one Pvt
// Ltd, and threading a tenant key through every posting call to support a
// second entity that does not exist would cost more than it saves.
// ============================================================

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Which side increases this account. Stored rather than derived from `type`
/// so a contra account — Sales Returns is an INCOME account that normally
/// carries a debit — is representable without a special case.
enum NormalBalance {
  DEBIT
  CREDIT
}

enum FinancialPeriodStatus {
  /// Accepts postings.
  OPEN
  /// No new postings. Reopenable by SUPER_ADMIN.
  CLOSED
  /// Permanently sealed — returns filed against it. Never reopenable.
  LOCKED
}

enum JournalSourceType {
  MANUAL
  SALES_INVOICE
  RECEIPT
  CREDIT_NOTE
  DEBIT_NOTE
  SUPPLIER_BILL
  SUPPLIER_PAYMENT
  EXPENSE
  STOCK_MOVEMENT
  OPENING_BALANCE
  REVERSAL
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

/// Subledger attribution for an AR/AP line. Not an FK because the party may
/// live in either the Customer or the Supplier table.
enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum TaxTreatment {
  TAXABLE
  NIL_RATED
  EXEMPT
  /// Exports and SEZ supplies.
  ZERO_RATED
  NON_GST
}

/// The selling legal entity. One row in practice, but a table rather than
/// constants so the GSTIN, address and bank details printed on a tax invoice
/// come from data an admin can correct — not from a string literal baked
/// into a PDF template, which is where the current quotation PDF keeps them.
model Company {
  id        String  @id @default(cuid())
  legalName String
  tradeName String?
  gstin     String?
  pan       String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  /// Origin state for place-of-supply comparison. An invoice is intra-state
  /// (CGST+SGST) when this equals the customer's place of supply, and
  /// inter-state (IGST) otherwise.
  state        String
  /// GST numeric state code, e.g. "19" for West Bengal.
  stateCode    String?
  pincode      String?

  phone String?
  email String?

  bankName      String?
  bankAccountNo String?
  bankIfsc      String?
  bankBranch    String?

  /// Financial year start month, 1-12. India is 4 (April). Configurable
  /// rather than assumed, but defaulted so nothing has to set it.
  fyStartMonth Int     @default(4)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialPeriods FinancialPeriod[]
  documentSeries   DocumentSeries[]
}

/// A node in the chart of accounts.
model LedgerAccount {
  id String @id @default(cuid())

  /// Stable, human-meaningful identifier used in reports and referenced by
  /// AccountMapping. Immutable once postings exist against the account.
  code String @unique
  name String

  type          LedgerAccountType
  normalBalance NormalBalance

  parentId String?
  parent   LedgerAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children LedgerAccount[] @relation("AccountTree")

  /// Only leaf accounts may carry postings. A parent exists to group and
  /// subtotal its children; posting directly to it would double-count in
  /// every rolled-up report.
  isPostable Boolean @default(true)

  /// Created by the chart-of-accounts seed and resolved by AccountMapping.
  /// May be renamed, never deleted or deactivated — the posting service
  /// depends on it existing.
  isSystem Boolean @default(false)

  isActive    Boolean @default(true)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    JournalLine[]
  mappings AccountMapping[]

  @@index([type])
  @@index([parentId])
  @@index([isActive])
}

/// One month of one financial year. An Indian FY runs 1 April - 31 March.
model FinancialPeriod {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// The FY's starting calendar year: FY 2026-27 is stored as 2026.
  financialYear Int

  /// 1-12 where 1 = April, so ordering by this is chronological within the
  /// financial year rather than the calendar year.
  periodNumber Int

  /// Display label, e.g. "Apr 2026".
  label     String
  startDate DateTime
  endDate   DateTime

  status     FinancialPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  closedBy   User?                 @relation("PeriodCloser", fields: [closedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries JournalEntry[]

  @@unique([companyId, financialYear, periodNumber])
  @@index([startDate, endDate])
  @@index([status])
}

/// A balanced set of debits and credits. Immutable once POSTED: a mistake is
/// corrected by a linked reversing entry, never by editing these rows.
model JournalEntry {
  id          String   @id @default(cuid())
  entryNumber String   @unique
  entryDate   DateTime

  periodId String
  period   FinancialPeriod @relation(fields: [periodId], references: [id])

  narration String
  status    JournalEntryStatus @default(POSTED)

  sourceType JournalSourceType
  /// The business document this was generated from. Null for MANUAL entries.
  /// Not an FK — the source may be any of several tables.
  sourceId   String?

  /// Unique per logical posting, so a retried Server Action, a double submit
  /// or a replayed webhook cannot post the same document twice. Composed by
  /// the caller as sourceType:sourceId:revision.
  idempotencyKey String @unique

  /// Set on a reversing entry, pointing at what it reverses. One-to-one:
  /// an entry may be reversed only once.
  reversesEntryId String?       @unique
  reverses        JournalEntry? @relation("EntryReversal", fields: [reversesEntryId], references: [id])
  reversedBy      JournalEntry? @relation("EntryReversal")

  postedById String
  postedBy   User     @relation("JournalPoster", fields: [postedById], references: [id])
  postedAt   DateTime @default(now())

  createdAt DateTime @default(now())

  lines JournalLine[]

  @@index([entryDate])
  @@index([periodId])
  @@index([sourceType, sourceId])
  @@index([status])
}

/// One side of one entry. Exactly one of debit/credit is non-zero, and both
/// are non-negative — a negative amount is never used to mean "the other
/// side", because it would break every SUM-based report.
model JournalLine {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// Position within the entry, so a ledger prints lines in the order they
  /// were written rather than by cuid.
  lineNumber Int

  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])

  debit  Decimal @default(0) @db.Decimal(16, 2)
  credit Decimal @default(0) @db.Decimal(16, 2)

  narration String?

  partyType PartyType?
  partyId   String?

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([accountId])
  @@index([partyType, partyId])
}

/// Named links from a posting role to a real account, so no account id or
/// code is ever hardcoded at a call site. Seeded alongside the chart of
/// accounts and validated at boot; a missing mapping fails loudly rather
/// than silently posting somewhere plausible.
model AccountMapping {
  id String @id @default(cuid())

  /// e.g. AR_TRADE, SALES_REVENUE, GST_OUTPUT_CGST, ROUND_OFF.
  key String @unique

  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Gapless, per-financial-year document numbering.
///
/// Replaces the COUNT(*)+1 scheme in src/lib/id-sequences.ts for financial
/// documents. GST Rule 46(b) requires a consecutive serial number unique
/// within a financial year; a row count is neither gapless nor per-FY, and
/// races under concurrency. nextNumber is incremented under a row lock
/// inside the same transaction that inserts the document.
model DocumentSeries {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// SALES_INVOICE, RECEIPT, CREDIT_NOTE, JOURNAL, ...
  documentType  String
  financialYear Int

  prefix  String
  /// Zero-padding width of the numeric part.
  padding Int    @default(4)

  nextNumber Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, documentType, financialYear])
}

/// GST rate master, keyed by HSN.
///
/// Rates are data, never literals in code: Urvar's accountant owns these
/// values and organic-manure classification is rate-sensitive. The
/// effectiveFrom/To window keeps a historical invoice re-derivable after a
/// rate change.
model TaxRate {
  id          String  @id @default(cuid())
  hsnCode     String
  description String?

  treatment TaxTreatment @default(TAXABLE)

  /// Total GST percent. CGST/SGST is always half each and IGST is the full
  /// rate, so storing one number keeps intra- and inter-state consistent by
  /// construction rather than by three columns that can drift apart.
  ratePercent Decimal @db.Decimal(5, 2)
  cessPercent Decimal @default(0) @db.Decimal(5, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  /// False until a tax professional has signed the classification off. The
  /// tax engine refuses to price an invoice from an unverified row, so the
  /// system cannot quietly invent a rate — see the brief's rule that GST
  /// treatment is never assumed.
  isVerified   Boolean @default(false)
  verifiedNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hsnCode, effectiveFrom])
  @@index([isVerified])
}
