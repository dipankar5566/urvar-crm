# Local PostgreSQL (Windows service, see CLAUDE.md — not a portable install;
# the scripts/pg-start.ps1 this comment used to reference was never created)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urvar_crm?schema=public"

# Phase 0 of the sales-funnel automation roadmap: nightly pg_dump, run by
# scripts/backup-db.ps1 via a Windows Scheduled Task (see
# scripts/register-backup-task.ps1). BACKUP_DIR is outside the repo and
# outside storage/ on purpose — see the Phase 0 plan for why.
BACKUP_DIR="D:\Backups\urvar-crm"
BACKUP_RETENTION_DAYS="14"

# Better Auth
BETTER_AUTH_SECRET="change-me"
# BETTER_AUTH_URL isn't read by our own code, but the better-auth package
# itself reads it directly as its server-side baseURL — omitting it logs a
# "Base URL is not set" warning and can break callback/redirect URLs.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AES-256 key (base64, 32 bytes decoded) for encrypting secrets at rest —
# currently just the per-user Plivo Endpoint password. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Plivo Voice (in-browser calling) — from the Plivo console (console.plivo.com):
# Auth ID + Auth Token: Home page
# App ID: Applications > (the app) > Application ID, shown in the edit panel
#   — Answer URL: {APP_URL}/api/voice/plivo/answer, Hangup URL: {APP_URL}/api/voice/plivo/status
# Caller ID: a Voice-capable Plivo number, in E.164 format, India (+91) (e.g. +919876543210)
# — Indian numbers require an approved Plivo KYC application (business proof)
#   before they're purchasable; see the Plivo setup note in CLAUDE.md.
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""
PLIVO_APP_ID=""
PLIVO_CALLER_ID=""

# Local directory where downloaded call recordings (.mp3) are stored.
CALL_RECORDINGS_DIR="./storage/call-recordings"

# Outbound email (SMTP) — used for quotation delivery to customers and for
# follow-up/task due reminders to reps. Deliberately provider-agnostic: point
# it at whatever host serves info@urvarindia.com (Zoho, Google Workspace,
# cPanel, …). Port 465 is treated as implicit TLS; 587/25 use STARTTLS.
# With SMTP_HOST or SMTP_FROM unset, email is skipped and reminders stay
# in-app only — nothing errors.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Urvar Natural <info@urvarindia.com>"

# Phase 6 of the sales-funnel automation roadmap: adds a one-click accept
# link (src/app/api/quotations/accept/[token]) to the quotation email,
# letting a customer accept without a rep and auto-creating the Order. Off
# by default — this is the highest-consequence autonomous write path
# shipped so far (an unauthenticated action creates a real Order), so it
# stays dark until Phase 0's backup/restore is confirmed working AND a
# human deliberately decides to flip it. Deploying this code is not that
# decision.
QUOTATION_ACCEPT_LINK_ENABLED="false"

# WhatsApp Business via Plivo (a Meta Solution Provider — same account as
# voice above, so no new AUTH_ID/TOKEN). Requires a WABA connected in the
# Plivo console and a Meta-approved template before anything can send, which
# is a manual multi-day step: leave WHATSAPP_ENABLED false until it is done,
# then flip it (a PM2 restart, no rebuild).
#
# Register the quotation template under Meta's *Utility* category, not
# Marketing — it is a transactional document the customer asked for. India
# rates: Utility ~Rs 0.1265/message vs Marketing ~Rs 0.9494/message.
WHATSAPP_ENABLED="false"
# The WABA sender number, E.164 (e.g. +919876543210).
PLIVO_WHATSAPP_NUMBER=""
# Name of the approved template. Its body takes three positional params, in
# order: customer name, quotation number, total amount.
WHATSAPP_TEMPLATE_QUOTATION_SENT=""

# Uploaded documents (enquiry forms, visiting cards, scans) that Sarvam's
# document API extracts fields from. Same local-disk pattern as recordings:
# files are named by their File row id and served through /api/documents/<id>,
# which authorises the database row before reading anything off disk.
DOCUMENTS_DIR="./storage/documents"

# AI Voice Agent (Phase 0+) — OpenAI is Phase 1's reasoning/dialogue layer
# (swapped from Claude 2026-09-09; Phase 2's provider is a separate, still-
# undecided choice — see the plan). Get a key at platform.openai.com.
OPENAI_API_KEY=""
# Phase 1's lightweight call-assist suggestion/summary calls.
OPENAI_MODEL="gpt-5.4-mini"
# Phase 2's autonomous conversation agent (tool-calling) — full tier, not
# -mini, given the higher stakes of unsupervised dialogue.
OPENAI_AGENT_MODEL="gpt-5.4"

# Which LLM answers Phase 2 calls: "openai" (default) or "sarvam".
# Sarvam's sarvam-105b-conversations is purpose-built for voice agents and
# measured ~3x faster to first word (median TTFT ~400ms vs ~1090ms) while
# matching the incumbent on tool behaviour — see `npm run eval:agent`.
# Switching is an env edit plus `pm2 restart urvar-voice-agent`, so a live
# pilot can be reverted in seconds. Provider differences (auth header, base
# URL, reasoning_effort values, token-limit field) live in
# voice-agent/pipeline/llm-provider.ts.
VOICE_AGENT_LLM_PROVIDER="openai"

# How long to wait for a live-call completion before giving up. The SDK
# default is 10 minutes, which on a phone call is indistinguishable from a
# dead line; measured median time to first token is ~430ms, so 6s is many
# times the normal case while still failing fast enough to play the holding
# line instead of silence.
VOICE_AGENT_LLM_TIMEOUT_MS="6000"

# Barge-in strategy. "two-stage" (default) interrupts on Sarvam's VAD speech
# onset and commits once a partial transcript proves it was real speech.
# Set to "final-only" and restart for the previous behaviour, where the AI
# kept talking until the lead's whole sentence had been transcribed.
VOICE_AGENT_BARGE_IN="two-stage"

# Live transfer to a rep on a clear buying signal. Set to "false" to withdraw
# the capability without a deploy — the agent then books a callback instead.
AI_TRANSFER_ENABLED="true"

# Phase 5 of the sales-funnel automation roadmap: lets the AI create-and-send
# a quotation on its own, but only inside the Phase-4 safe zone (existing
# customer, standard pricing, no discount, value cap — see src/lib/safe-zone.ts).
# Fail-closed (opt-in), unlike AI_TRANSFER_ENABLED's fail-open convention —
# this writes a real customer-facing Quotation and emails it autonomously,
# so it stays off until a human deliberately turns it on. Requires
# QUOTATION_ACCEPT_LINK_ENABLED's migration (Quotation.acceptToken) to
# already be applied — run `npm run eval:agent` before flipping this.
AI_AUTO_QUOTE_ENABLED="false"

# Sarvam AI (Indic-language streaming STT/TTS — Saaras v3 / Bulbul v3) —
# get a key at dashboard.sarvam.ai. Auth is a plain `API-SUBSCRIPTION-KEY`
# WebSocket header (confirmed against Sarvam's own docs, not the SDK's
# client-level parameter name).
SARVAM_API_KEY=""
SARVAM_STT_MODEL="saaras:v3-realtime"
# Silence after the lead stops talking before a final transcript is emitted.
# A fixed cost on every single turn (Sarvam's own default is 500ms). Lower
# shortens the gap but starts clipping people who pause mid-answer — change
# it against the `[turn]` log lines, not by feel.
SARVAM_STT_SILENCE_MS="300"
# Used only when VOICE_AGENT_LLM_PROVIDER="sarvam".
SARVAM_AGENT_MODEL="sarvam-105b-conversations"
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_TTS_VOICE="shubh"
# Optional voice tuning, both unset by default. bulbul:v3 accepts pace
# 0.5-2.0 and temperature 0.01-1.0 (pitch/loudness are v2-only). Pick by
# listening to `npm run tts:samples` rather than guessing.
SARVAM_TTS_PACE=""
SARVAM_TTS_TEMPERATURE=""
# Forces one TTS voice language instead of deriving it from Lead.state.
SARVAM_TTS_LANGUAGE=""

# voice-agent/server.ts — the standalone Node process (PM2 app
# "urvar-voice-agent") hosting the Plivo <Stream> and browser live-assist
# WebSocket endpoints. VOICE_AGENT_PUBLIC_URL is the wss:// URL reachable
# from Plivo/the browser (via the Cloudflare Tunnel route — see CLAUDE.md).
VOICE_AGENT_PORT="3010"
# Single-level subdomain of urvarindia.com — required to fit the existing
# Cloudflare Universal SSL cert, whose SAN list is only
# "urvarindia.com, *.urvarindia.com" (one label deep). A two-level hostname
# like voice.crm.urvarindia.com has no matching certificate and fails TLS
# handshake at Cloudflare's edge (confirmed via openssl s_client during setup).
VOICE_AGENT_PUBLIC_URL="wss://voice.urvarindia.com"
# Same URL, exposed to the browser bundle — server-side env vars aren't
# available client-side, and `live-assist-panel.tsx` connects directly to
# this WS URL from the browser.
NEXT_PUBLIC_VOICE_AGENT_WS_URL="wss://voice.urvarindia.com"
# HMAC secret for the short-lived signed token `getAssistToken` issues so the
# voice-agent process (no Better Auth session access) can authorize a
# browser's live-assist WS connection. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VOICE_AGENT_TOKEN_SECRET=""

# NOTE: this flag has no code wired to it anywhere in the repo (confirmed by
# repo-wide search during the Phase 7 build) — apparently dead config from an
# earlier plan revision. Phase 7's actual outbound backlog sweep uses the
# distinct AI_OUTBOUND_BACKLOG_ENABLED flag below instead. Left here
# un-repurposed since its original intent is unclear; worth removing
# separately.
AI_CAMPAIGNS_ENABLED="false"

# Phase 7 of the sales-funnel automation roadmap: an in-process cron sweep
# (src/lib/ai-backlog-cron.ts) that dials AI outbound calls into the backlog
# of leads reps have never gotten to. DO NOT SET TO "true" IN PRODUCTION
# until legal/compliance has signed off on TRAI DND exposure for this lead
# population — see all.md's Phase 7. Fail-closed; the schedule itself
# (10:00-18:30 IST) is the quiet-hours enforcement, not a runtime check.
AI_OUTBOUND_BACKLOG_ENABLED="false"
# Hours since Lead.createdAt before an unworked lead enters the backlog —
# deliberately past both reminder-cron.ts's existing stale-lead escalation
# thresholds (rep at 24h, manager at 72h), so this is a last-resort net,
# not a race against those.
AI_OUTBOUND_BACKLOG_MIN_AGE_HOURS="96"
# Cap on outbound calls placed per sweep tick, to avoid a dialing storm on
# first enable.
AI_OUTBOUND_BACKLOG_MAX_PER_TICK="5"
# Fallback FollowUp assignee when an AI-flagged callback's lead has no
# assigned rep (User.id).
AI_CALL_FALLBACK_USER_ID=""
