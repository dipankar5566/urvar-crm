# Local PostgreSQL (portable install, see scripts/pg-start.ps1)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urvar_crm?schema=public"

# Better Auth
BETTER_AUTH_SECRET="change-me"
# BETTER_AUTH_URL isn't read by our own code, but the better-auth package
# itself reads it directly as its server-side baseURL — omitting it logs a
# "Base URL is not set" warning and can break callback/redirect URLs.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AES-256 key (base64, 32 bytes decoded) for encrypting secrets at rest —
# currently just the per-user Plivo Endpoint password. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Plivo Voice (in-browser calling) — from the Plivo console (console.plivo.com):
# Auth ID + Auth Token: Home page
# App ID: Applications > (the app) > Application ID, shown in the edit panel
#   — Answer URL: {APP_URL}/api/voice/plivo/answer, Hangup URL: {APP_URL}/api/voice/plivo/status
# Caller ID: a Voice-capable Plivo number, in E.164 format, India (+91) (e.g. +919876543210)
# — Indian numbers require an approved Plivo KYC application (business proof)
#   before they're purchasable; see the Plivo setup note in CLAUDE.md.
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""
PLIVO_APP_ID=""
PLIVO_CALLER_ID=""

# Local directory where downloaded call recordings (.mp3) are stored.
CALL_RECORDINGS_DIR="./storage/call-recordings"
