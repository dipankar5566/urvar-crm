# Local PostgreSQL (portable install, see scripts/pg-start.ps1)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urvar_crm?schema=public"

# Better Auth
BETTER_AUTH_SECRET="change-me"
# BETTER_AUTH_URL isn't read by our own code, but the better-auth package
# itself reads it directly as its server-side baseURL — omitting it logs a
# "Base URL is not set" warning and can break callback/redirect URLs.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AES-256 key (base64, 32 bytes decoded) for encrypting secrets at rest —
# currently just the per-user Plivo Endpoint password. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Plivo Voice (in-browser calling) — from the Plivo console (console.plivo.com):
# Auth ID + Auth Token: Home page
# App ID: Applications > (the app) > Application ID, shown in the edit panel
#   — Answer URL: {APP_URL}/api/voice/plivo/answer, Hangup URL: {APP_URL}/api/voice/plivo/status
# Caller ID: a Voice-capable Plivo number, in E.164 format, India (+91) (e.g. +919876543210)
# — Indian numbers require an approved Plivo KYC application (business proof)
#   before they're purchasable; see the Plivo setup note in CLAUDE.md.
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""
PLIVO_APP_ID=""
PLIVO_CALLER_ID=""

# Local directory where downloaded call recordings (.mp3) are stored.
CALL_RECORDINGS_DIR="./storage/call-recordings"

# Uploaded documents (enquiry forms, visiting cards, scans) that Sarvam's
# document API extracts fields from. Same local-disk pattern as recordings:
# files are named by their File row id and served through /api/documents/<id>,
# which authorises the database row before reading anything off disk.
DOCUMENTS_DIR="./storage/documents"

# AI Voice Agent (Phase 0+) — OpenAI is Phase 1's reasoning/dialogue layer
# (swapped from Claude 2026-09-09; Phase 2's provider is a separate, still-
# undecided choice — see the plan). Get a key at platform.openai.com.
OPENAI_API_KEY=""
# Phase 1's lightweight call-assist suggestion/summary calls.
OPENAI_MODEL="gpt-5.4-mini"
# Phase 2's autonomous conversation agent (tool-calling) — full tier, not
# -mini, given the higher stakes of unsupervised dialogue.
OPENAI_AGENT_MODEL="gpt-5.4"

# Which LLM answers Phase 2 calls: "openai" (default) or "sarvam".
# Sarvam's sarvam-105b-conversations is purpose-built for voice agents and
# measured ~3x faster to first word (median TTFT ~400ms vs ~1090ms) while
# matching the incumbent on tool behaviour — see `npm run eval:agent`.
# Switching is an env edit plus `pm2 restart urvar-voice-agent`, so a live
# pilot can be reverted in seconds. Provider differences (auth header, base
# URL, reasoning_effort values, token-limit field) live in
# voice-agent/pipeline/llm-provider.ts.
VOICE_AGENT_LLM_PROVIDER="openai"

# Sarvam AI (Indic-language streaming STT/TTS — Saaras v3 / Bulbul v3) —
# get a key at dashboard.sarvam.ai. Auth is a plain `API-SUBSCRIPTION-KEY`
# WebSocket header (confirmed against Sarvam's own docs, not the SDK's
# client-level parameter name).
SARVAM_API_KEY=""
SARVAM_STT_MODEL="saaras:v3-realtime"
# Used only when VOICE_AGENT_LLM_PROVIDER="sarvam".
SARVAM_AGENT_MODEL="sarvam-105b-conversations"
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_TTS_VOICE="shubh"
# Optional voice tuning, both unset by default. bulbul:v3 accepts pace
# 0.5-2.0 and temperature 0.01-1.0 (pitch/loudness are v2-only). Pick by
# listening to `npm run tts:samples` rather than guessing.
SARVAM_TTS_PACE=""
SARVAM_TTS_TEMPERATURE=""
# Forces one TTS voice language instead of deriving it from Lead.state.
SARVAM_TTS_LANGUAGE=""

# voice-agent/server.ts — the standalone Node process (PM2 app
# "urvar-voice-agent") hosting the Plivo <Stream> and browser live-assist
# WebSocket endpoints. VOICE_AGENT_PUBLIC_URL is the wss:// URL reachable
# from Plivo/the browser (via the Cloudflare Tunnel route — see CLAUDE.md).
VOICE_AGENT_PORT="3010"
# Single-level subdomain of urvarindia.com — required to fit the existing
# Cloudflare Universal SSL cert, whose SAN list is only
# "urvarindia.com, *.urvarindia.com" (one label deep). A two-level hostname
# like voice.crm.urvarindia.com has no matching certificate and fails TLS
# handshake at Cloudflare's edge (confirmed via openssl s_client during setup).
VOICE_AGENT_PUBLIC_URL="wss://voice.urvarindia.com"
# Same URL, exposed to the browser bundle — server-side env vars aren't
# available client-side, and `live-assist-panel.tsx` connects directly to
# this WS URL from the browser.
NEXT_PUBLIC_VOICE_AGENT_WS_URL="wss://voice.urvarindia.com"
# HMAC secret for the short-lived signed token `getAssistToken` issues so the
# voice-agent process (no Better Auth session access) can authorize a
# browser's live-assist WS connection. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VOICE_AGENT_TOKEN_SECRET=""

# Phase 3 kill switch for the outbound AI campaign scheduler — false until
# Phase 1+2 are validated on real calls.
AI_CAMPAIGNS_ENABLED="false"
# Fallback FollowUp assignee when an AI-flagged callback's lead has no
# assigned rep (User.id).
AI_CALL_FALLBACK_USER_ID=""
