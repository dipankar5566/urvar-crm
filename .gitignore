# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-*.log

# PM2 process logs
/logs

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Claude Code local settings
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated

# local file storage (uploaded attachments / generated PDFs)
/storage

# KML source files for the Leads import wizard's dealer-pin path. Real
# prospect data — named businesses, phone numbers, addresses, GPS, sales
# tiers and estimated tonnage — so it stays on disk, out of git history.
/kml

# Vyapar export files and the opening-balance migration script (real
# customer/supplier names, phone numbers, balances, loan amounts) — stays on
# disk, out of git history, same reasoning as /kml above.
/vyapar
